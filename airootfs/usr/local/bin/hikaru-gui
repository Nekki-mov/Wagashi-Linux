# ── GPU utils ──────────────────────────────────────────────────────────────────
def _detect_cpu_vendor():
    result = subprocess.run("grep -m1 'vendor_id' /proc/cpuinfo", shell=True, capture_output=True, text=True)
    return "amd" if "AuthenticAMD" in result.stdout else "intel"

def _get_gpus():
    result = subprocess.run("lspci -nn | grep -E 'VGA|3D|Display'", shell=True, capture_output=True, text=True)
    gpus = []
    for line in result.stdout.strip().split("\n"):
        if not line: continue
        pci_addr = line.split()[0]
        vendor = "nvidia" if "NVIDIA" in line.upper() else "amd" if ("AMD" in line.upper() or "ATI" in line.upper()) else "other"
        match = _re.search(r'\[([0-9a-f]{4}:[0-9a-f]{4})\]', line)
        device_id = match.group(1) if match else "unknown"
        gpus.append((pci_addr, vendor, device_id, line.strip()))
    return gpus

def _resolve_gpu_auto(gpu_choice, ask_fn=None):
    gpus = _get_gpus()
    if not gpus or gpu_choice == "none": return None
    if gpu_choice in ("nvidia", "amd"):
        candidates = [(a, v, d, l) for a, v, d, l in gpus if v == gpu_choice]
        if not candidates: return None
        if len(candidates) == 1: return candidates[0][0], candidates[0][1], candidates[0][2]
        if ask_fn:
            idx = ask_fn(candidates)
            return candidates[idx][0], candidates[idx][1], candidates[idx][2]
        return candidates[0][0], candidates[0][1], candidates[0][2]
    if gpu_choice == "auto":
        if len(gpus) <= 1: return None
        if ask_fn:
            idx = ask_fn(gpus)
            return gpus[idx][0], gpus[idx][1], gpus[idx][2]
        return gpus[-1][0], gpus[-1][1], gpus[-1][2]
    return None

def purpose_packages(purpose):
    """Returns (official_pkgs_str, aur_pkgs_str)"""
    always_official = [
        "htop", "btop", "gparted", "keepassxc", "okular", "ark", "spectacle",
        "cups", "system-config-printer", "wine", "winetricks",
    ]
    always_aur = ["proton-ge-custom-bin"]

    everyday_official = ["firefox", "libreoffice-fresh", "thunderbird", "vlc", "gimp", "gwenview"]
    everyday_aur = []

    creative_official = [
        "krita", "gimp", "inkscape", "kdenlive", "obs-studio", "blender",
        "audacity", "scribus", "musescore",
    ]
    creative_aur = ["davinci-resolve"]

    dev_official = [
        "code", "git", "base-devel", "docker", "docker-compose", "neovim",
        "github-cli", "nodejs", "dbeaver", "meld",
    ]
    dev_aur = ["postman-bin"]

    gaming_official = ["steam", "lutris", "gamemode", "mangohud", "discord"]
    gaming_aur = ["heroic-games-launcher-bin"]

    mapping = {
        "everyday":        ([everyday_official], [everyday_aur]),
        "creative":        ([creative_official], [creative_aur]),
        "dev":             ([dev_official], [dev_aur]),
        "gaming":          ([gaming_official], [gaming_aur]),
        "gaming_creative": ([gaming_official, creative_official], [gaming_aur, creative_aur]),
        "creative_dev":    ([creative_official, dev_official], [creative_aur, dev_aur]),
        "everything":      ([everyday_official, creative_official, dev_official, gaming_official],
                             [everyday_aur, creative_aur, dev_aur, gaming_aur]),
    }

    off_lists, aur_lists = mapping.get(purpose, ([everyday_official], [everyday_aur]))

    official = list(always_official)
    for o in off_lists:
        official += o

    aur = list(always_aur)
    for a in aur_lists:
        aur += a

    def dedupe(lst):
        seen = set()
        out = []
        for p in lst:
            if p not in seen:
                seen.add(p)
                out.append(p)
        return out

    return " ".join(dedupe(official)), " ".join(dedupe(aur))

# ── Base page ──────────────────────────────────────────────────────────────────
def _host_gpu_packages():
    result = subprocess.run("lspci -nn | grep -E 'VGA|3D|Display'", shell=True, capture_output=True, text=True)
    lines = [l for l in result.stdout.strip().split("\n") if l]
    official, aur = [], []
    for line in lines:
        upper = line.upper()
        if "NVIDIA" in upper:
            if any(x in upper for x in ("RTX", "GTX 16")):
                official.append("nvidia-open-dkms")
            elif any(x in upper for x in ("GTX 9", "GTX 10", "TITAN")):
                official.append("nvidia-dkms")
            else:
                aur.append("nvidia-470xx-dkms")
        elif "AMD" in upper or "ATI" in upper:
            official += ["vulkan-radeon", "libva-mesa-driver"]
        elif "INTEL" in upper:
            official += ["vulkan-intel", "intel-media-driver"]
    return " ".join(sorted(set(official))), " ".join(sorted(set(aur)))


class BasePage(QWidget):
    def __init__(self, window):
        super().__init__()
        self.window = window
        self._outer = QVBoxLayout(self)
        self._outer.setContentsMargins(0, 0, 0, 0)
        self._outer.setSpacing(0)

        # Card/pill — floats over the background
        card_color = COLORS.get("card", COLORS["surface"])
        self._card = QWidget()
        self._card.setStyleSheet(
            f"background-color: {card_color};"
            f"border-radius: 20px;"
        )
        self._card.setMaximumWidth(760)
        self._card.setMinimumWidth(580)

        self._center = QWidget()
        self._center.setMaximumWidth(640)
        self._center.setStyleSheet("background: transparent;")
        self.layout = QVBoxLayout(self._center)
        self.layout.setContentsMargins(0, 60, 0, 48)
        self.layout.setSpacing(0)

        card_inner = QHBoxLayout()
        card_inner.addStretch()
        card_inner.addWidget(self._center)
        card_inner.addStretch()
        card_layout = QVBoxLayout(self._card)
        card_layout.setContentsMargins(0, 0, 0, 0)
        card_layout.addLayout(card_inner)

        wrap = QHBoxLayout()
        wrap.addStretch()
        wrap.addWidget(self._card)
        wrap.addStretch()

        outer_wrap = QVBoxLayout()
        outer_wrap.addStretch()
        outer_wrap.addLayout(wrap)
        outer_wrap.addStretch()
        self._outer.addLayout(outer_wrap)

    def add_title(self, text):
        label = QLabel(text)
        label.setObjectName("title")
        label.setWordWrap(True)
        label.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.layout.addWidget(label)
        self.layout.addSpacing(12)

    def add_subtitle(self, text):
        label = QLabel(text)
        label.setObjectName("subtitle")
        label.setWordWrap(True)
        label.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.layout.addWidget(label)
        self.layout.addSpacing(48)

    def add_section(self, text):
        label = QLabel(text if any(ord(c) > 127 for c in text) else text.upper())
        label.setObjectName("section")
        label.setAlignment(Qt.AlignmentFlag.AlignLeft)
        self.layout.addWidget(label)
        self.layout.addSpacing(12)

    def add_nav(self, back=True, next_text=None, next_fn=None):
        T = self.window.T
        back_text = {"en": "← back", "es": "← atrás", "ja": "← 戻る"}.get(self.window.lang, "← back")
        self.layout.addStretch()
        self.layout.addSpacing(40)
        row = QHBoxLayout()
        if back:
            btn_back = QPushButton(back_text)
            btn_back.setObjectName("secondary")
            btn_back.clicked.connect(self.window.prev_page)
            row.addWidget(btn_back)
        row.addStretch()
        continue_text = {"en": "Continue", "es": "Continuar", "ja": "次へ"}.get(self.window.lang, "Continue")
        btn_next = QPushButton(next_text or continue_text)
        btn_next.setObjectName("primary")
        btn_next.clicked.connect(next_fn or self.window.next_page)
        row.addWidget(btn_next)
        self.layout.addLayout(row)

# ── Window ─────────────────────────────────────────────────────────────────────
class HikaruWindow(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Hikaru")
        self.setMinimumSize(900, 600)
        self.setStyleSheet(STYLE)
        self.data = {}
        self.lang = "en"
        self.T = STRINGS["en"]
        self.stack = QStackedWidget()
        self.setCentralWidget(self.stack)

        self.lang_page = LanguagePage(self)
        self.stack.addWidget(self.lang_page)
        self.main_pages = []
        self.stack.setCurrentIndex(0)

    def set_language(self, lang):
        self.lang = lang
        self.T = STRINGS[lang]
        self.data["lang"] = lang
        self._build_main_pages()
        self.stack.setCurrentWidget(self.main_pages[0])

    def _build_main_pages(self):
        for page in self.main_pages:
            self.stack.removeWidget(page)
        self.main_pages = [
            WelcomePage(self),
            KeyboardPage(self),
            NetworkPage(self),
            UserPage(self),
            TimezonePage(self),
            PurposePage(self),
            DiskPage(self),
            VirtualizationPage(self),
            SecurityPage(self),
            SummaryPage(self),
            InstallPage(self),
            DonePage(self),
        ]
        for page in self.main_pages:
            self.stack.addWidget(page)

    def next_page(self):
        i = self.main_pages.index(self.stack.currentWidget()) if self.stack.currentWidget() in self.main_pages else -1
        if i >= 0 and i < len(self.main_pages) - 1:
            self.stack.setCurrentWidget(self.main_pages[i + 1])

    def prev_page(self):
        i = self.main_pages.index(self.stack.currentWidget()) if self.stack.currentWidget() in self.main_pages else -1
        if i > 0:
            self.stack.setCurrentWidget(self.main_pages[i - 1])

# ── Language page ──────────────────────────────────────────────────────────────
class LanguagePage(QWidget):
    def __init__(self, window):
        super().__init__()
        self.window = window
        outer = QVBoxLayout(self)
        outer.addStretch()

        card_color = COLORS.get("card", COLORS["surface"])
        card = QWidget()
        card.setStyleSheet(f"background-color: {card_color}; border-radius: 20px;")
        card.setMaximumWidth(400)

        center = QWidget()
        center.setMaximumWidth(320)
        center.setStyleSheet("background: transparent;")
        layout = QVBoxLayout(center)
        layout.setSpacing(16)
        layout.setContentsMargins(0, 48, 0, 48)

        for lang_code, label, font in [
            ("en", "English",  COLORS['font_body']),
            ("es", "Español",  COLORS['font_body']),
            ("ja", "日本語",   "Noto Sans CJK JP"),
        ]:
            btn = QPushButton(label)
            btn.setObjectName("lang")
            btn.setStyleSheet(f"font-family: '{font}'; font-size: 16px;")
            btn.clicked.connect(lambda checked, lc=lang_code: self.window.set_language(lc))
            layout.addWidget(btn)

        card_inner = QHBoxLayout()
        card_inner.addStretch()
        card_inner.addWidget(center)
        card_inner.addStretch()
        card_layout = QVBoxLayout(card)
        card_layout.setContentsMargins(0, 0, 0, 0)
        card_layout.addLayout(card_inner)

        wrap = QHBoxLayout()
        wrap.addStretch()
        wrap.addWidget(card)
        wrap.addStretch()
        outer.addLayout(wrap)
        outer.addStretch()

