# ── Edition detection ─────────────────────────────────────────────────────────
def detect_edition():
    try:
        with open("/etc/os-release") as f:
            content = f.read()
        if "Sayuri" in content or "Monochrome" in content:
            return "sayuri"
        if "Nayuki" in content or "LXQt" in content:
            return "nayuki"
    except Exception:
        pass
    return "ayu"

EDITION = detect_edition()

