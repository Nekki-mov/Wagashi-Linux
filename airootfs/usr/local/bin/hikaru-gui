class SummaryPage(BasePage):
    def __init__(self, window):
        super().__init__(window)
        T = window.T
        self.add_title(T["SUMMARY_TITLE"])
        self.add_subtitle(T["SUMMARY_WARNING"])

        self.summary = QLabel()
        self.summary.setStyleSheet(
            f"color: {COLORS['text_dim']}; font-size: 14px; background: transparent; "
            f"line-height: 180%; font-family: monospace;"
        )
        self.summary.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.layout.addWidget(self.summary)

        ushio_note = QLabel(T["SUMMARY_USHIO_DESC"])
        ushio_note.setStyleSheet(f"color: {COLORS['text_ghost']}; font-size: 12px; background: transparent;")
        ushio_note.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.layout.addSpacing(8)
        self.layout.addWidget(ushio_note)
        confirm_text = {"en": "let's go", "es": "comenzar", "ja": "始める"}.get(window.lang, "let's go")
        self.add_nav(next_text=confirm_text, next_fn=self.window.next_page)

    def showEvent(self, event):
        T = self.window.T
        d = self.window.data
        yes = T["SUMMARY_YES"]
        no  = T["SUMMARY_NO"]

        purpose_map = {
            "everyday":        T["PURPOSE_EVERYDAY"].split("—")[0].strip().split("·")[0].strip().split("—")[0].strip(),
            "creative":        T["PURPOSE_CREATIVE"].split("—")[0].strip(),
            "dev":             T["PURPOSE_DEV"].split("—")[0].strip(),
            "gaming":          T["PURPOSE_GAMING"].split("—")[0].strip(),
            "gaming_creative": T["PURPOSE_GAMING_CREATIVE"].split("—")[0].strip(),
            "creative_dev":    T["PURPOSE_CREATIVE_DEV"].split("—")[0].strip(),
            "everything":      T["PURPOSE_EVERYTHING"].split("—")[0].strip(),
        }
        layout_map = {
            "simple":    T["LAYOUT_SIMPLE"].split("—")[0].strip().split(".")[0].strip(),
            "separated": T["LAYOUT_SEPARATED"].split("—")[0].strip().split(".")[0].strip(),
            "encrypted": T["LAYOUT_ENCRYPTED"].split("—")[0].strip().split(".")[0].strip(),
        }

        purpose_val = purpose_map.get(d.get("purpose", ""), d.get("purpose", "—"))
        layout_val  = layout_map.get(d.get("layout", ""),  d.get("layout",  "—"))
        ushio_val   = yes if d.get("virtualization") else no

        rows = [
            (T["SUMMARY_USER"],     d.get("username", "—")),
            (T["SUMMARY_COMPUTER"], d.get("hostname",  "—")),
            (T["SUMMARY_KEYBOARD"], d.get("keyboard",  "us")),
            (T["SUMMARY_TIMEZONE"], d.get("timezone",  "UTC")),
            (T["SUMMARY_DISK"],     d.get("disk_label", d.get("disk", "—"))),
            (T["SUMMARY_SETUP"],    layout_val),
            (T["SUMMARY_PURPOSE"],  purpose_val),
            (T["SUMMARY_FIREWALL"], yes if d.get("firewall")     else no),
            (T["SUMMARY_UPDATES"],  yes if d.get("auto_updates") else no),
            (T["SUMMARY_USHIO"],    ushio_val),
        ]
        bg = COLORS['bg']
        ghost = COLORS['text_ghost']
        dim = COLORS['text_dim']
        lines = f"<table style='border-spacing: 16px 6px; background: {bg};'>"
        for k, v in rows:
            lines += f"<tr><td style='color: {ghost}; text-align: right;'>{k}</td><td style='color: {dim};'>{v}</td></tr>"
        lines += "</table>"
        self.summary.setText(lines)
        self.summary.setStyleSheet("background: transparent; font-size: 14px;")


class InstallWorker(QThread):
    status_changed = pyqtSignal(str, int)
    log_line       = pyqtSignal(str)
    finished       = pyqtSignal()

    def __init__(self, data):
        super().__init__()
        self.data = data

    def run_cmd(self, cmd, check=True):
        self.log_line.emit(f"$ {cmd}")
        with open("/tmp/hikaru-install.log", "a") as logf:
            logf.write(f"$ {cmd}\n")
        result = subprocess.run(cmd, shell=True, capture_output=True, text=True)
        for line in result.stdout.strip().split("\n"):
            if line:
                self.log_line.emit(line)
                with open("/tmp/hikaru-install.log", "a") as logf:
                    logf.write(line + "\n")
        for line in result.stderr.strip().split("\n"):
            if line:
                self.log_line.emit(f"[err] {line}")
                with open("/tmp/hikaru-install.log", "a") as logf:
                    logf.write(f"[err] {line}\n")
        return result

    def write_file(self, path, content):
        try:
            os.makedirs(os.path.dirname(path), exist_ok=True)
            with open(path, "w") as f:
                f.write(content)
        except Exception as e:
            self.log_line.emit(f"[err] write_file {path}: {e}")

    def status(self, msg, pct):
        self.status_changed.emit(msg, pct)
        self.log_line.emit(f"── {msg}")

    def run(self):
        try:
            self._run()
        except Exception as e:
            self.log_line.emit(f"[fatal] {e}")
            self.status_changed.emit(f"Something went wrong: {e}", 0)

    def _run(self):
        d         = self.data
        T         = STRINGS.get(d.get("lang", "en"), STRINGS["en"])
        disk      = d["disk"]
        disk_name = d["disk_name"]
        is_nvme   = "nvme" in disk_name
        part_efi  = f"{disk}p1" if is_nvme else f"{disk}1"
        part_root = f"{disk}p2" if is_nvme else f"{disk}2"
        part_home = f"{disk}p3" if is_nvme else f"{disk}3"
        timezone  = d.get("timezone", "UTC")
        keyboard  = d.get("keyboard", "us")
        layout    = d.get("layout",   "simple")
        username  = d["username"]
        lang      = d.get("lang", "en")

        self.status(T["INSTALL_DISK"], 5)
        self.run_cmd(f"wipefs -af {disk}")
        self.run_cmd(f"parted -s {disk} mklabel gpt")
        self.run_cmd(f"parted -s {disk} mkpart ESP fat32 1MiB 513MiB")
        self.run_cmd(f"parted -s {disk} set 1 esp on")

        if layout == "separated":
            self.run_cmd(f"parted -s {disk} mkpart root ext4 513MiB 60%")
            self.run_cmd(f"parted -s {disk} mkpart home ext4 60% 100%")
            self.run_cmd(f"mkfs.ext4 -F {part_home}")
        elif layout == "encrypted":
            self.run_cmd(f"parted -s {disk} mkpart root ext4 513MiB 100%")
            self.status(T["LAYOUT_ENCRYPT_INTRO"], 10)
            self.run_cmd(f"cryptsetup luksFormat {part_root}")
            self.run_cmd(f"cryptsetup open {part_root} wagashi_crypt")
            part_root = "/dev/mapper/wagashi_crypt"
        else:
            self.run_cmd(f"parted -s {disk} mkpart root ext4 513MiB 100%")

        self.status(T["INSTALL_FORMAT"], 15)
        self.run_cmd(f"mkfs.fat -F32 {part_efi}")
        self.run_cmd(f"mkfs.ext4 -F {part_root}")

        self.status(T["INSTALL_MOUNT"], 20)
        self.run_cmd(f"mount {part_root} /mnt")
        self.run_cmd(f"mount --mkdir {part_efi} /mnt/boot/efi")
        if layout == "separated":
            self.run_cmd(f"mount --mkdir {part_home} /mnt/home")

        self.status(T["INSTALL_PACKAGES"], 25)
        base = (
            "base linux-zen linux-firmware sudo networkmanager grub efibootmgr "
            "zsh nano git curl wget htop unzip tar man-db "
            "pipewire pipewire-pulse wireplumber bluez bluez-utils cups iwd power-profiles-daemon "
            "mesa noto-fonts noto-fonts-cjk noto-fonts-emoji ttf-liberation ttf-bitstream-vera "
            "xorg-server xorg-xwayland "
            "plasma-desktop plasma-pa plasma-nm plasma-firewall plasma-systemmonitor "
            "sddm sddm-kcm discover kscreen powerdevil bluedevil kwallet-pam "
            "breeze breeze-gtk kde-gtk-config "
            "dolphin konsole python-pyqt6 plymouth fwupd alsa-utils v4l-utils sane libwacom xf86-input-wacom ghostscript foomatic-db-engine foomatic-db"
        )
        extra_official, extra_aur = purpose_packages(d.get("purpose", "everyday"))
        gpu_official, gpu_aur = _host_gpu_packages()
        if gpu_official:
            extra_official = f"{extra_official} {gpu_official}".strip()
        if gpu_aur:
            extra_aur = f"{extra_aur} {gpu_aur}".strip()
        self.run_cmd(f"pacstrap /mnt {base} {extra_official}".strip())

        self.status(T["INSTALL_CONFIG"], 70)
        self.run_cmd("genfstab -U /mnt >> /mnt/etc/fstab")
        self.run_cmd(f"arch-chroot /mnt ln -sf /usr/share/zoneinfo/{timezone} /etc/localtime")
        self.run_cmd("arch-chroot /mnt hwclock --systohc")
        self.run_cmd(f"echo '{d['hostname']}' > /mnt/etc/hostname")
        self.write_file("/mnt/etc/hosts",
            f"127.0.0.1   localhost\n::1         localhost\n127.0.1.1   {d['hostname']}.localdomain {d['hostname']}\n"
        )
        self.run_cmd("echo 'en_US.UTF-8 UTF-8' >> /mnt/etc/locale.gen")
        if lang == "es":
            self.run_cmd("echo 'es_ES.UTF-8 UTF-8' >> /mnt/etc/locale.gen")
        if lang == "ja":
            self.run_cmd("echo 'ja_JP.UTF-8 UTF-8' >> /mnt/etc/locale.gen")
        self.run_cmd("arch-chroot /mnt locale-gen")
        locale = "ja_JP.UTF-8" if lang == "ja" else "es_ES.UTF-8" if lang == "es" else "en_US.UTF-8"
        self.run_cmd(f"echo 'LANG={locale}' > /mnt/etc/locale.conf")
        if keyboard != "us":
            self.run_cmd(f"echo 'KEYMAP={keyboard}' > /mnt/etc/vconsole.conf")
            X11_LAYOUT_MAP = {"uk": "gb", "pt-latin1": "pt"}
            x11_layout = X11_LAYOUT_MAP.get(keyboard, keyboard)
            self.write_file(
                "/mnt/etc/X11/xorg.conf.d/00-keyboard.conf",
                'Section "InputClass"\n'
                '    Identifier "system-keyboard"\n'
                '    MatchIsKeyboard "on"\n'
                f'    Option "XkbLayout" "{x11_layout}"\n'
                'EndSection\n'
            )

        self.run_cmd(f"arch-chroot /mnt groupadd -f sddm-bg")
        self.status(T["INSTALL_USER"], 78)
        self.run_cmd("mkdir -p /mnt/etc/skel/.config/plasma-workspace/shutdown")
        self.run_cmd("cp /etc/skel/.config/plasma-org.kde.plasma.desktop-appletsrc /mnt/etc/skel/.config/plasma-org.kde.plasma.desktop-appletsrc")
        self.run_cmd("cp /etc/skel/.config/plasma-workspace/shutdown/sync-sddm-wallpaper.sh /mnt/etc/skel/.config/plasma-workspace/shutdown/sync-sddm-wallpaper.sh")
        self.run_cmd("cp /etc/skel/.config/kdeglobals /mnt/etc/skel/.config/kdeglobals")
        self.run_cmd("cp /etc/skel/.config/kxkbrc /mnt/etc/skel/.config/kxkbrc")
        self.run_cmd(f"arch-chroot /mnt useradd -m -G wheel,sddm-bg -s /bin/zsh {username}")
        self.run_cmd(f"echo '{username}:{d['password']}' | arch-chroot /mnt chpasswd")
        self.run_cmd(f"echo 'root:{d['password']}' | arch-chroot /mnt chpasswd")
        self.run_cmd(f"arch-chroot /mnt mkdir -p /usr/share/sddm/themes/wagashi/backgrounds")
        self.run_cmd(f"arch-chroot /mnt chgrp sddm-bg /usr/share/sddm/themes/wagashi/backgrounds")
        self.run_cmd(f"arch-chroot /mnt chmod 775 /usr/share/sddm/themes/wagashi/backgrounds")
        self.run_cmd("echo '%wheel ALL=(ALL:ALL) ALL' >> /mnt/etc/sudoers")

        self.status(T.get("INSTALL_AUR", "Setting up a few extra things..."), 84)
        self.run_cmd("arch-chroot /mnt pacman -S --noconfirm --needed git base-devel")
        self.run_cmd(
            f"arch-chroot /mnt su {username} -c "
            f"\"git clone https://aur.archlinux.org/yay-bin.git /tmp/yay-bin && "
            f"cd /tmp/yay-bin && makepkg -si --noconfirm\""
        )
        self.run_cmd("arch-chroot /mnt pacman -S --noconfirm")
        if extra_aur:
            self.run_cmd(
                f"arch-chroot /mnt su {username} -c "
                f"\"yay -S --noconfirm --needed {extra_aur}\""
            )

        self.status(T["INSTALL_BOOTLOADER"], 82)
        self.run_cmd("arch-chroot /mnt grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=Wagashi")
        self.run_cmd("mkdir -p /mnt/etc/NetworkManager/conf.d")
        self.write_file("/mnt/etc/NetworkManager/conf.d/wifi_backend.conf", "[device]\nwifi.backend=iwd\n")
        self.run_cmd("mkdir -p /mnt/boot/efi/EFI/BOOT")
        self.run_cmd("cp /mnt/boot/efi/EFI/Wagashi/grubx64.efi /mnt/boot/efi/EFI/BOOT/BOOTX64.EFI")
        self.run_cmd("mkdir -p /mnt/boot/grub/themes/wagashi")
        self.run_cmd("cp -r /usr/share/grub/themes/wagashi/. /mnt/boot/grub/themes/wagashi/")
        self.write_file("/mnt/etc/default/grub",
            'GRUB_DEFAULT=0\nGRUB_TIMEOUT=5\nGRUB_DISTRIBUTOR=""\n'
            'GRUB_CMDLINE_LINUX_DEFAULT="quiet splash"\nGRUB_CMDLINE_LINUX=""\n'
            'GRUB_THEME="/boot/grub/themes/wagashi/theme.txt"\n'
            'GRUB_GFXMODE="1920x1080,auto"\nGRUB_GFXPAYLOAD_LINUX=keep\n'
        )
        self.run_cmd("sync")
        self.run_cmd("arch-chroot /mnt grub-mkconfig -o /boot/grub/grub.cfg")
        self.write_file("/mnt/boot/grub/themes/wagashi/theme.txt",
            '# Wagashi Linux GRUB Theme\n# Silence is a design choice.\n\n'
            'title-text: ""\ndesktop-color: "#000000"\n\n'
            '+ label {\n  left = 50%-300\n  top = 38%\n  width = 600\n  height = 40\n'
            '  text = "Wagashi Linux"\n  font = "wagashi-36.pf2"\n  color = "#ffffff"\n  align = "center"\n}\n\n'
            '+ label {\n  left = 50%-300\n  top = 46%\n  width = 600\n  height = 20\n'
            '  text = "your computer, always yours."\n  font = "wagashi-14.pf2"\n  color = "#333333"\n  align = "center"\n}\n\n'
            '+ boot_menu {\n  left = 50%-160\n  top = 56%\n  width = 320\n  height = 140\n'
            '  item_font = "wagashi-14.pf2"\n  item_color = "#444444"\n'
            '  selected_item_color = "#e8a0a0"\n  selected_item_style = "bold"\n'
            '  item_height = 32\n  item_padding = 0\n  item_spacing = 4\n  scrollbar = false\n}\n'
        )
        self.run_cmd("mkdir -p /mnt/usr/share/wallpapers")
        self.run_cmd("cp -r /usr/share/wallpapers/Wagashi-Ayu-Light /mnt/usr/share/wallpapers/")

        self.status(T["INSTALL_BRANDING"], 86)
        self.run_cmd("cp /usr/local/bin/wagashi-firstrun /mnt/usr/local/bin/wagashi-firstrun")
        self.run_cmd("chmod +x /mnt/usr/local/bin/wagashi-firstrun")
        self.run_cmd("mkdir -p /mnt/usr/share/wagashi/wallpapers")
        self.run_cmd("cp -r /usr/share/wagashi/wallpapers/. /mnt/usr/share/wagashi/wallpapers/")
        self.run_cmd("cp /usr/local/bin/hikaru-gui /mnt/usr/local/bin/hikaru-gui")
        self.run_cmd("chmod +x /mnt/usr/local/bin/hikaru-gui")
        self.run_cmd("cp /usr/local/bin/hikaru /mnt/usr/local/bin/hikaru")
        self.run_cmd("chmod +x /mnt/usr/local/bin/hikaru")
        self.run_cmd("cp /usr/local/bin/hikaru_strings.py /mnt/usr/local/bin/hikaru_strings.py")

        self.run_cmd("mkdir -p /mnt/etc/sddm.conf.d")
        self.write_file("/mnt/etc/sddm.conf.d/wagashi.conf",
            "[Theme]\nCurrent=breeze\n\n[Autologin]\nRelogin=false\n"
        )

        self.write_file("/mnt/etc/os-release",
            'NAME="Wagashi Linux"\nPRETTY_NAME="Wagashi Linux - Ayu (KDE)"\n'
            'VERSION="1.0 (Natto)"\nVERSION_ID="1.0"\nVARIANT_ID=ayu\n'
            'ID=wagashi\nID_LIKE=arch\nBUILD_ID=rolling\nANSI_COLOR="1;35"\n'
            'HOME_URL="https://wagashi.neklair.es"\nLOGO=wagashi\n'
        )
        self.run_cmd("mkdir -p /mnt/usr/share/pixmaps")
        self.run_cmd("mkdir -p /mnt/usr/share/icons/hicolor/scalable/apps")
        self.run_cmd("cp /usr/share/pixmaps/wagashi.svg /mnt/usr/share/pixmaps/wagashi.svg")
        self.run_cmd("cp /usr/share/icons/hicolor/scalable/apps/wagashi.svg /mnt/usr/share/icons/hicolor/scalable/apps/wagashi.svg")
        self.write_file("/mnt/etc/motd", "Welcome to Wagashi Linux — Ayu (KDE).\nYour computer, always yours.\n")

        self.status(T["INSTALL_PLYMOUTH"], 88)
        self.run_cmd("mkdir -p /mnt/usr/share/plymouth/themes/wagashi")
        self.run_cmd("cp -r /usr/share/plymouth/themes/wagashi/. /mnt/usr/share/plymouth/themes/wagashi/")
        self.write_file("/mnt/etc/mkinitcpio.conf",
            "HOOKS=(base udev plymouth autodetect microcode modconf kms block filesystems keyboard fsck)\n"
        )
        self.run_cmd("arch-chroot /mnt plymouth-set-default-theme wagashi")

        self.status(T["INSTALL_INITRAMFS"], 90)
        self.run_cmd("arch-chroot /mnt mkinitcpio -P")

        self.status(T["INSTALL_DANGO"], 93)
        self.run_cmd("cp /usr/local/bin/dango /mnt/usr/local/bin/dango")
        self.run_cmd("chmod +x /mnt/usr/local/bin/dango")
        self.run_cmd("mkdir -p /mnt/usr/lib/systemd/system-sleep")
        self.run_cmd("cp /usr/lib/systemd/system-sleep/wagashi-broadcom-wifi-fix /mnt/usr/lib/systemd/system-sleep/wagashi-broadcom-wifi-fix")
        self.run_cmd("chmod +x /mnt/usr/lib/systemd/system-sleep/wagashi-broadcom-wifi-fix")

        self.status(T["INSTALL_SERVICES"], 94)
        self.run_cmd("arch-chroot /mnt systemctl enable NetworkManager")
        self.run_cmd("arch-chroot /mnt systemctl enable power-profiles-daemon")
        self.run_cmd("arch-chroot /mnt systemctl enable iwd")
        self.run_cmd("arch-chroot /mnt systemctl mask wpa_supplicant")
        self.run_cmd("arch-chroot /mnt systemctl enable sddm")
        self.run_cmd("arch-chroot /mnt systemctl enable bluetooth")
        self.run_cmd("arch-chroot /mnt systemctl enable cups")

        if d.get("firewall"):
            self.run_cmd("pacstrap /mnt ufw")
            self.run_cmd("arch-chroot /mnt systemctl enable ufw")
            self.run_cmd("arch-chroot /mnt ufw --force enable")

        if d.get("virtualization"):
            self.status(T["USHIO_SETTING_UP"], 97)
            self.run_cmd("pacstrap /mnt qemu-full libvirt virt-manager dnsmasq")
            self.run_cmd("arch-chroot /mnt systemctl enable libvirtd")
            self.run_cmd(f"arch-chroot /mnt usermod -aG libvirt {username}")
            self._setup_passthrough(d.get("gpu_passthrough", "none"))

        self.status(T["INSTALL_ALMOST"], 99)

        # home files — escritos como root, chown via arch-chroot al final
        home = f"/mnt/home/{username}"
        self.run_cmd(f"mkdir -p {home}/.config/autostart")
        self.write_file(f"{home}/.config/autostart/wagashi-firstrun.desktop",
            "[Desktop Entry]\nType=Application\nName=Wagashi First Run\n"
            "Exec=/usr/local/bin/wagashi-firstrun\nIcon=dialog-scripts\n"
            "X-KDE-autostart-after=panel\n"
        )
        self.write_file(f"{home}/.zshrc",
            'pierogi() { echo "O KURWA"; }\n'
            "calçot() { echo \"Did you know, Hatsune Miku was made by Catalonian people? Yeah, Miku was made by Pompeu Fabra University, so IT'S NOT A FUCKING LEEK, IT'S A CALÇOT, VISCA LA TERRA NOI!\"; }\n"
        )
        # chown dentro del chroot — garantiza permisos correctos
        self.run_cmd(f"arch-chroot /mnt chown -R {username}:{username} /home/{username}")

        self.status(T["DONE_TITLE"], 100)
        self.finished.emit()

    def _setup_passthrough(self, gpu_choice):
        if gpu_choice == "none": return
        result = _resolve_gpu_auto(gpu_choice)
        if result is None: return
        pci_addr, vendor, device_id = result
        cpu = _detect_cpu_vendor()
        iommu_param = "amd_iommu=on" if cpu == "amd" else "intel_iommu=on"
        with open("/mnt/etc/default/grub", "r") as f:
            grub = f.read()
        if iommu_param not in grub:
            grub = grub.replace(
                'GRUB_CMDLINE_LINUX_DEFAULT="quiet splash"',
                f'GRUB_CMDLINE_LINUX_DEFAULT="quiet splash {iommu_param} iommu=pt"'
            )
            with open("/mnt/etc/default/grub", "w") as f:
                f.write(grub)
        with open("/mnt/etc/modprobe.d/vfio.conf", "w") as f:
            f.write(f"options vfio-pci ids={device_id}\n")
            if vendor == "nvidia":
                f.write("softdep nvidia pre: vfio vfio_pci\nsoftdep nouveau pre: vfio vfio_pci\n")
        with open("/mnt/etc/mkinitcpio.conf", "r") as f:
            mk = f.read()
        if "vfio_pci" not in mk:
            with open("/mnt/etc/mkinitcpio.conf", "w") as f:
                f.write("MODULES=(vfio_pci vfio vfio_iommu_type1)\n" + mk)
        if vendor == "nvidia":
            with open("/mnt/etc/modprobe.d/nvidia-vfio.conf", "w") as f:
                f.write("options kvm ignore_msrs=1\noptions kvm report_ignored_msrs=0\n")
        self.run_cmd("arch-chroot /mnt grub-mkconfig -o /boot/grub/grub.cfg")
        self.run_cmd("arch-chroot /mnt mkinitcpio -P")


class InstallPage(BasePage):
    def __init__(self, window):
        super().__init__(window)
        T = window.T
        self.add_title(T["INSTALL_START"].split(".")[0] + ".")
        self.add_subtitle(T["INSTALL_PACKAGES"])

        self.progress = QProgressBar()
        self.progress.setRange(0, 100)
        self.progress.setValue(0)
        self.progress.setTextVisible(False)
        self.layout.addWidget(self.progress)
        self.layout.addSpacing(24)

        starting_text = {"en": "starting...", "es": "preparando...", "ja": "準備中..."}.get(window.lang, "starting...")
        self.status = QLabel(starting_text)
        self.status.setObjectName("accent")
        self.status.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.layout.addWidget(self.status)
        self.layout.addSpacing(16)

        self.recent = QLabel("")
        self.recent.setStyleSheet(f"color: {COLORS['text_dim']}; font-size: 12px; background: transparent;")
        self.recent.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.recent.setWordWrap(True)
        self.layout.addWidget(self.recent)
        self.layout.addStretch()
        self._recent_lines = []
        self.worker = None

    def showEvent(self, event):
        QTimer.singleShot(200, self.start_install)

    def start_install(self):
        self.worker = InstallWorker(self.window.data)
        self.worker.status_changed.connect(self.update_status)
        self.worker.log_line.connect(self.append_log)
        self.worker.finished.connect(lambda: QTimer.singleShot(1500, self.window.next_page))
        self.worker.start()

    def update_status(self, msg, pct):
        self.status.setText(msg)
        self.progress.setValue(pct)

    def append_log(self, line):
        if line.startswith("── "):
            self._recent_lines.append(line[3:])
            if len(self._recent_lines) > 3:
                self._recent_lines.pop(0)
            self.recent.setText("\n".join(self._recent_lines))


class DonePage(BasePage):
    def __init__(self, window):
        super().__init__(window)
        self.layout.addStretch()

        self.title_label = QLabel("")
        self.title_label.setObjectName("title")
        self.title_label.setAlignment(Qt.AlignmentFlag.AlignCenter)
        done_color = COLORS['text'] if EDITION == "nayuki" else COLORS['accent']
        self.title_label.setStyleSheet(f"font-family: '{COLORS['font_title']}'; font-size: 56px; font-weight: 300; color: {done_color}; background: transparent;")
        self.layout.addWidget(self.title_label)
        self.layout.addSpacing(24)

        self.username_label = QLabel("")
        self.username_label.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.username_label.setStyleSheet(f"color: {COLORS['text']}; font-size: 18px; background: transparent;")
        self.layout.addWidget(self.username_label)
        self.layout.addSpacing(12)

        self.tagline_label = QLabel("")
        self.tagline_label.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.tagline_label.setStyleSheet(f"color: {COLORS['text_dim']}; font-size: 13px; background: transparent;")
        self.layout.addWidget(self.tagline_label)

        self.layout.addStretch()

        self.countdown = 10
        self.reboot_btn = QPushButton("")
        self.reboot_btn.setObjectName("primary")
        self.reboot_btn.clicked.connect(self.do_reboot)
        btn_layout = QHBoxLayout()
        btn_layout.addStretch()
        btn_layout.addWidget(self.reboot_btn)
        btn_layout.addStretch()
        self.layout.addLayout(btn_layout)

        self.timer = QTimer()
        self.timer.timeout.connect(self.tick)

    def tick(self):
        self.countdown -= 1
        if self.countdown <= 0:
            self.do_reboot()
        else:
            T = self.window.T
            self.reboot_btn.setText(f"{T['DONE_REBOOT_BTN']} ({self.countdown})")

    def do_reboot(self):
        self.timer.stop()
        subprocess.run("reboot", shell=True)

    def showEvent(self, event):
        T = self.window.T
        username = self.window.data.get("username", "")
        self.title_label.setText(T["DONE_TITLE"])
        self.username_label.setText(T["DONE_WELCOME"].format(username=username))
        self.tagline_label.setText(T["DONE_TAGLINE"])
        self.countdown = 10
        self.reboot_btn.setText(f"{T['DONE_REBOOT_BTN']} ({self.countdown})")
        self.timer.start(1000)


if __name__ == "__main__":
    app = QApplication(sys.argv)
    app.setApplicationName("Hikaru")
    window = HikaruWindow()
    window.showFullScreen()
    sys.exit(app.exec())
