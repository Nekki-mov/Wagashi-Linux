        self.window.next_page()


class SummaryPage(BasePage):
    def __init__(self, window):
        super().__init__(window)
        self.add_title("Here's the plan.")
        self.add_subtitle("Everything on that disk will be replaced with Wagashi Linux.")

        self.summary = QLabel()
        self.summary.setStyleSheet(f"color: {COLORS['text_dim']}; font-size: 14px; background: transparent; line-height: 200%;")
        self.summary.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.layout.addWidget(self.summary)
        self.add_nav(next_text="let's go", next_fn=self.window.next_page)

    def showEvent(self, event):
        d = self.window.data
        rows = [
            ("user",        d.get("username", "—")),
            ("computer",    d.get("hostname",  "—")),
            ("keyboard",    d.get("keyboard",  "us")),
            ("timezone",    d.get("timezone",  "UTC")),
            ("disk",        d.get("disk",      "—")),
            ("setup",       d.get("layout",    "—")),
            ("purpose",     d.get("purpose",   "—")),
            ("firewall",    "yes" if d.get("firewall")      else "no"),
            ("updates",     "yes" if d.get("auto_updates")  else "no"),
            ("ushio",       "yes" if d.get("virtualization") else "no"),
        ]
        lines = "\n".join(f"{k:<14}{v}" for k, v in rows)
        self.summary.setText(lines)


class InstallWorker(QThread):
    status_changed = pyqtSignal(str, int)
    log_line       = pyqtSignal(str)
    finished       = pyqtSignal()

    def __init__(self, data):
        super().__init__()
        self.data = data

    def run_cmd(self, cmd):
        self.log_line.emit(f"$ {cmd}")
        result = subprocess.run(cmd, shell=True, capture_output=True, text=True)
        for line in result.stdout.strip().split("\n"):
            if line: self.log_line.emit(line)
        for line in result.stderr.strip().split("\n"):
            if line: self.log_line.emit(f"[err] {line}")
        return result

    def write_file(self, path, content):
        """Write a file directly from Python — no shell heredoc issues."""
        with open(path, "w") as f:
            f.write(content)

    def status(self, msg, pct):
        self.status_changed.emit(msg, pct)
        self.log_line.emit(f"── {msg}")

    def run(self):
        d         = self.data
        disk      = d["disk"]
        disk_name = d["disk_name"]
        is_nvme   = "nvme" in disk_name
        part_efi  = f"{disk}p1" if is_nvme else f"{disk}1"
        part_root = f"{disk}p2" if is_nvme else f"{disk}2"
        part_home = f"{disk}p3" if is_nvme else f"{disk}3"
        timezone  = d.get("timezone", "UTC")
        keyboard  = d.get("keyboard", "us")
        layout    = d.get("layout",   "simple")
        username  = d["username"]

        # ── Disk ──────────────────────────────────────────────────────────────
        self.status("Making room for Wagashi.", 5)
        self.run_cmd(f"wipefs -af {disk}")
        self.run_cmd(f"parted -s {disk} mklabel gpt")
        self.run_cmd(f"parted -s {disk} mkpart ESP fat32 1MiB 513MiB")
        self.run_cmd(f"parted -s {disk} set 1 esp on")

        if layout == "separated":
            self.run_cmd(f"parted -s {disk} mkpart root ext4 513MiB 60%")
            self.run_cmd(f"parted -s {disk} mkpart home ext4 60% 100%")
            self.run_cmd(f"mkfs.ext4 -F {part_home}")
        elif layout == "encrypted":
            self.run_cmd(f"parted -s {disk} mkpart root ext4 513MiB 100%")
            self.status("Locking the door. You'll have the only key.", 10)
            self.run_cmd(f"cryptsetup luksFormat {part_root}")
            self.run_cmd(f"cryptsetup open {part_root} wagashi_crypt")
            part_root = "/dev/mapper/wagashi_crypt"
        else:
            self.run_cmd(f"parted -s {disk} mkpart root ext4 513MiB 100%")

        self.status("A blank page.", 15)
        self.run_cmd(f"mkfs.fat -F32 {part_efi}")
        self.run_cmd(f"mkfs.ext4 -F {part_root}")

        self.status("Getting things in order.", 20)
        self.run_cmd(f"mount {part_root} /mnt")
        self.run_cmd(f"mount --mkdir {part_efi} /mnt/boot/efi")
        if layout == "separated":
            self.run_cmd(f"mount --mkdir {part_home} /mnt/home")

        # ── Packages ──────────────────────────────────────────────────────────
        self.status("Installing Wagashi Linux. This is the slow part.", 25)
        base = (
            "base linux-zen linux-firmware sudo networkmanager grub efibootmgr "
            "zsh nano git curl wget htop unzip tar man-db "
            "pipewire pipewire-pulse wireplumber bluez bluez-utils cups "
            "mesa noto-fonts noto-fonts-emoji ttf-liberation ttf-bitstream-vera "
            "lxqt openbox lightdm lightdm-gtk-greeter accountsservice "
            "python-pyqt6 plymouth sakura pcmanfm-qt xdg-user-dirs"
        )
        extra = purpose_packages(d.get("purpose", "everyday"))
        self.run_cmd(f"pacstrap /mnt {base} {extra}".strip())

        # ── System config ─────────────────────────────────────────────────────
        self.status("Teaching the system where it is.", 70)
        self.run_cmd("genfstab -U /mnt >> /mnt/etc/fstab")
        self.run_cmd(f"arch-chroot /mnt ln -sf /usr/share/zoneinfo/{timezone} /etc/localtime")
        self.run_cmd("arch-chroot /mnt hwclock --systohc")
        self.run_cmd(f"echo '{d['hostname']}' > /mnt/etc/hostname")
        self.run_cmd("echo 'en_US.UTF-8 UTF-8' >> /mnt/etc/locale.gen")
        self.run_cmd("arch-chroot /mnt locale-gen")
        self.run_cmd("echo 'LANG=en_US.UTF-8' > /mnt/etc/locale.conf")
        if keyboard != "us":
            self.run_cmd(f"echo 'KEYMAP={keyboard}' > /mnt/etc/vconsole.conf")

        # ── User ──────────────────────────────────────────────────────────────
        self.status("Setting a place for you.", 78)
        self.run_cmd(f"arch-chroot /mnt useradd -m -G wheel -s /bin/zsh {username}")
        self.run_cmd(f"echo '{username}:{d['password']}' | arch-chroot /mnt chpasswd")
        self.run_cmd("echo '%wheel ALL=(ALL:ALL) ALL' >> /mnt/etc/sudoers")

        # ── User LXQt config ──────────────────────────────────────────────────
        home = f"/mnt/home/{username}"
        self.run_cmd(f"mkdir -p {home}/.config/autostart")

        # wagashi-firstrun autostart
        self.write_file(f"{home}/.config/autostart/wagashi-firstrun.desktop",
            "[Desktop Entry]\n"
            "Type=Application\n"
            "Name=Wagashi First Run\n"
            "Exec=/usr/local/bin/wagashi-firstrun\n"
            "Icon=dialog-scripts\n"
            "X-LXQT-Need-Tray=false\n"
        )

        # easter eggs en zshrc
        self.write_file(f"{home}/.zshrc",
            'pierogi() { echo "O KURWA"; }\n'
            'calçot() { echo "Did you know, Hatsune Miku was made by Catalonian people?'
            ' Yeah, Miku was made by Pompeu Fabra University,'
            " so IT'S NOT A FUCKING LEEK, IT'S A CALÇOT, VISCA LA TERRA NOI!\"; }\n"
        )

        self.run_cmd(f"chown -R {username}:{username} {home}")

        # ── /etc/hosts ────────────────────────────────────────────────────────
        hostname = d.get("hostname", "wagashi")
        self.write_file("/mnt/etc/hosts",
            f"127.0.0.1   localhost\n"
            f"::1         localhost\n"
            f"127.0.1.1   {hostname}.localdomain {hostname}\n"
        )

        # ── Bootloader ────────────────────────────────────────────────────────
        self.status("Telling the computer how to wake up.", 82)
        self.run_cmd("arch-chroot /mnt grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=Wagashi")
        self.run_cmd("mkdir -p /mnt/boot/grub/themes/wagashi")
        self.run_cmd("cp -r /usr/share/grub/themes/wagashi/. /mnt/boot/grub/themes/wagashi/")
        self.write_file("/mnt/etc/default/grub",
            'GRUB_DEFAULT=0\n'
            'GRUB_TIMEOUT=5\n'
            'GRUB_DISTRIBUTOR=""\n'
            'GRUB_CMDLINE_LINUX_DEFAULT="quiet splash"\n'
            'GRUB_CMDLINE_LINUX=""\n'
            'GRUB_THEME="/boot/grub/themes/wagashi/theme.txt"\n'
            'GRUB_GFXMODE="1920x1080,auto"\n'
            'GRUB_GFXPAYLOAD_LINUX=keep\n'
        )
        self.run_cmd("sync")
        self.run_cmd("arch-chroot /mnt grub-mkconfig -o /boot/grub/grub.cfg")
        self.write_file("/mnt/boot/grub/themes/wagashi/theme.txt",
            '# Wagashi Linux GRUB Theme\n'
            '# Silence is a design choice.\n\n'
            'title-text: ""\n'
            'desktop-color: "#000000"\n\n'
            '+ label {\n'
            '  left = 50%-300\n  top = 38%\n  width = 600\n  height = 40\n'
            '  text = "Wagashi Linux"\n'
            '  font = "wagashi-36.pf2"\n'
            '  color = "#ffffff"\n'
            '  align = "center"\n}\n\n'
            '+ label {\n'
            '  left = 50%-300\n  top = 46%\n  width = 600\n  height = 20\n'
            '  text = "your computer, always yours."\n'
            '  font = "wagashi-14.pf2"\n'
            '  color = "#333333"\n'
            '  align = "center"\n}\n\n'
            '+ boot_menu {\n'
            '  left = 50%-160\n  top = 56%\n  width = 320\n  height = 140\n'
            '  item_font = "wagashi-14.pf2"\n'
            '  item_color = "#444444"\n'
            '  selected_item_color = "#e8a0a0"\n'
            '  selected_item_style = "bold"\n'
            '  item_height = 32\n  item_padding = 0\n  item_spacing = 4\n'
            '  scrollbar = false\n}\n'
        )

        # ── Wagashi assets ────────────────────────────────────────────────────
        self.status("Copying tools and setting things up.", 86)
        self.run_cmd("cp /usr/local/bin/wagashi-firstrun /mnt/usr/local/bin/wagashi-firstrun")
        self.run_cmd("chmod +x /mnt/usr/local/bin/wagashi-firstrun")
        self.run_cmd("cp /usr/local/bin/hikaru-gui /mnt/usr/local/bin/hikaru-gui")
        self.run_cmd("chmod +x /mnt/usr/local/bin/hikaru-gui")
        self.run_cmd("cp /usr/local/bin/hikaru /mnt/usr/local/bin/hikaru")
        self.run_cmd("chmod +x /mnt/usr/local/bin/hikaru")

        # LightDM config en sistema instalado
        self.run_cmd("mkdir -p /mnt/etc/lightdm")
        self.write_file("/mnt/etc/lightdm/lightdm.conf",
            "[LightDM]\n"
            "allow-guest=false\n"
            "\n"
            "[Seat:*]\n"
            "greeter-session=lightdm-gtk-greeter\n"
            "session-wrapper=/etc/lightdm/Xsession\n"
        )
        self.write_file("/mnt/etc/lightdm/Xsession",
            "#!/bin/sh\n"
            "xdg-user-dirs-update\n"
            "exec startlxqt\n"
        )
        self.run_cmd("chmod 755 /mnt/etc/lightdm/Xsession")

        # ── Branding ──────────────────────────────────────────────────────────
        self.status("Making it ours.", 87)
        self.write_file("/mnt/etc/os-release",
            'NAME="Wagashi Linux"\n'
            'PRETTY_NAME="Wagashi Linux - Nayuki (LXQt)"\n'
            'ID=wagashi\n'
            'ID_LIKE=arch\n'
            'BUILD_ID=rolling\n'
            'ANSI_COLOR="1;35"\n'
            'HOME_URL="https://wagashi.rednek.org"\n'
            'LOGO=wagashi\n'
        )
        self.write_file("/mnt/etc/motd",
            "Welcome to Wagashi Linux — Nayuki (LXQt).\nYour computer, always yours.\n"
        )

        # ── Plymouth ──────────────────────────────────────────────────────────
        self.status("Dressing the boot screen.", 89)
        self.run_cmd("mkdir -p /mnt/usr/share/plymouth/themes/wagashi")
        self.run_cmd("cp -r /usr/share/plymouth/themes/wagashi/. /mnt/usr/share/plymouth/themes/wagashi/")
        self.write_file("/mnt/etc/mkinitcpio.conf",
            "HOOKS=(base udev plymouth autodetect microcode modconf kms block filesystems keyboard fsck)\n"
        )
        self.run_cmd("arch-chroot /mnt plymouth-set-default-theme wagashi")
        self.run_cmd("arch-chroot /mnt mkinitcpio -P")

        # ── dango ─────────────────────────────────────────────────────────────
        self.status("Installing dango.", 93)
        self.run_cmd("cp /usr/local/bin/dango /mnt/usr/local/bin/dango")
        self.run_cmd("chmod +x /mnt/usr/local/bin/dango")

        # ── Services ──────────────────────────────────────────────────────────
        self.status("Starting the things that should always be running.", 94)
        self.run_cmd("arch-chroot /mnt systemctl enable NetworkManager")
        self.run_cmd("arch-chroot /mnt systemctl enable lightdm")
        self.run_cmd("arch-chroot /mnt systemctl enable bluetooth")
        self.run_cmd("arch-chroot /mnt systemctl enable cups")

        if d.get("firewall"):
            self.status("Closing the unnecessary windows.", 95)
            self.run_cmd("pacstrap /mnt ufw")
            self.run_cmd("arch-chroot /mnt systemctl enable ufw")
            self.run_cmd("arch-chroot /mnt ufw --force enable")

        if d.get("virtualization"):
            self.status("Preparing Ushio. Worlds within worlds.", 97)
            self.run_cmd("pacstrap /mnt qemu-full libvirt virt-manager dnsmasq")
            self.run_cmd("arch-chroot /mnt systemctl enable libvirtd")
            self.run_cmd(f"arch-chroot /mnt usermod -aG libvirt {username}")
            self._setup_passthrough(d.get("gpu_passthrough", "none"))

        self.status("Done.", 100)
        self.finished.emit()

    def _setup_passthrough(self, gpu_choice):
        if gpu_choice == "none":
            return
        result = _resolve_gpu_auto(gpu_choice)
        if result is None:
            return
        pci_addr, vendor, device_id = result
        cpu = _detect_cpu_vendor()
        iommu_param = "amd_iommu=on" if cpu == "amd" else "intel_iommu=on"
        with open("/mnt/etc/default/grub", "r") as f:
            grub = f.read()
        if iommu_param not in grub:
            grub = grub.replace(
                'GRUB_CMDLINE_LINUX_DEFAULT="quiet splash"',
                f'GRUB_CMDLINE_LINUX_DEFAULT="quiet splash {iommu_param} iommu=pt"'
            )
            with open("/mnt/etc/default/grub", "w") as f:
                f.write(grub)
        with open("/mnt/etc/modprobe.d/vfio.conf", "w") as f:
            f.write(f"options vfio-pci ids={device_id}\n")
            if vendor == "nvidia":
                f.write("softdep nvidia pre: vfio vfio_pci\n")
                f.write("softdep nouveau pre: vfio vfio_pci\n")
        with open("/mnt/etc/mkinitcpio.conf", "r") as f:
            mk = f.read()
        if "vfio_pci" not in mk:
            with open("/mnt/etc/mkinitcpio.conf", "w") as f:
                f.write("MODULES=(vfio_pci vfio vfio_iommu_type1)\n" + mk)
        if vendor == "nvidia":
            with open("/mnt/etc/modprobe.d/nvidia-vfio.conf", "w") as f:
                f.write("options kvm ignore_msrs=1\noptions kvm report_ignored_msrs=0\n")
        self.run_cmd("arch-chroot /mnt grub-mkconfig -o /boot/grub/grub.cfg")
        self.run_cmd("arch-chroot /mnt mkinitcpio -P")


class InstallPage(BasePage):
    def __init__(self, window):
        super().__init__(window)
        self.add_title("Installing.")
        self.add_subtitle("This will take a few minutes.")

        self.progress = QProgressBar()
        self.progress.setRange(0, 100)
        self.progress.setValue(0)
        self.layout.addWidget(self.progress)
        self.layout.addSpacing(24)

        self.status = QLabel("starting...")
        self.status.setObjectName("accent")
        self.status.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.layout.addWidget(self.status)
        self.layout.addSpacing(16)

        self.recent = QLabel("")
        self.recent.setStyleSheet(f"color: {COLORS['text_dim']}; font-size: 12px; background: transparent;")
        self.recent.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.recent.setWordWrap(True)
        self.layout.addWidget(self.recent)
        self.layout.addStretch()
        self._recent_lines = []
        self.worker = None

    def showEvent(self, event):
        QTimer.singleShot(200, self.start_install)

    def start_install(self):
        self.worker = InstallWorker(self.window.data)
        self.worker.status_changed.connect(self.update_status)
        self.worker.log_line.connect(self.append_log)
        self.worker.finished.connect(lambda: QTimer.singleShot(1500, self.window.next_page))
        self.worker.start()

    def update_status(self, msg, pct):
        self.status.setText(msg)
        self.progress.setValue(pct)

    def append_log(self, line):
        if line.startswith("── "):
            self._recent_lines.append(line[3:])
            if len(self._recent_lines) > 3:
                self._recent_lines.pop(0)
            self.recent.setText("\n".join(self._recent_lines))


