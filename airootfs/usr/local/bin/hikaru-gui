#!/usr/bin/env python3
# hikaru-gui — Wagashi Linux graphical installer
# "Light of the sky."

import sys
import subprocess
import os
from PyQt6.QtWidgets import *
from PyQt6.QtCore import *
from PyQt6.QtGui import *

import re as _re

def _detect_cpu_vendor():
    result = subprocess.run("grep -m1 'vendor_id' /proc/cpuinfo", shell=True, capture_output=True, text=True)
    return "amd" if "AuthenticAMD" in result.stdout else "intel"

def _get_gpus():
    result = subprocess.run("lspci -nn | grep -E 'VGA|3D|Display'", shell=True, capture_output=True, text=True)
    gpus = []
    for line in result.stdout.strip().split("\n"):
        if not line:
            continue
        pci_addr = line.split()[0]
        vendor = "nvidia" if "NVIDIA" in line.upper() else "amd" if ("AMD" in line.upper() or "ATI" in line.upper()) else "other"
        match = _re.search(r'\[([0-9a-f]{4}:[0-9a-f]{4})\]', line)
        device_id = match.group(1) if match else "unknown"
        gpus.append((pci_addr, vendor, device_id, line.strip()))
    return gpus

def _resolve_gpu_auto(gpu_choice, ask_fn=None):
    """Resuelve la GPU. Si hay ambigüedad, llama a ask_fn(gpus) -> índice."""
    gpus = _get_gpus()
    if not gpus or gpu_choice == "none":
        return None
    if gpu_choice in ("nvidia", "amd"):
        candidates = [(a, v, d, l) for a, v, d, l in gpus if v == gpu_choice]
        if not candidates:
            return None
        if len(candidates) == 1:
            return candidates[0][0], candidates[0][1], candidates[0][2]
        if ask_fn:
            idx = ask_fn(candidates)
            return candidates[idx][0], candidates[idx][1], candidates[idx][2]
        return candidates[0][0], candidates[0][1], candidates[0][2]
    if gpu_choice == "auto":
        if len(gpus) <= 1:
            return None
        # Siempre preguntar si hay más de una — el usuario sabe qué quiere
        if ask_fn:
            idx = ask_fn(gpus)
            return gpus[idx][0], gpus[idx][1], gpus[idx][2]
        return gpus[-1][0], gpus[-1][1], gpus[-1][2]
    return None



# ── Purpose packages ─────────────────────────────────
def purpose_packages(purpose):
    pkgs = []
    if purpose in ("everyday", "everything"):
        pkgs += ["firefox", "vlc"]
    if purpose in ("creative", "gaming_creative", "everything"):
        pkgs += ["krita", "kdenlive", "obs-studio", "inkscape"]
    if purpose in ("dev", "everything"):
        pkgs += ["code", "docker", "python", "nodejs", "npm"]
    if purpose in ("gaming", "gaming_creative", "everything"):
        pkgs += ["steam", "lutris", "wine", "winetricks", "gamemode"]
    return " ".join(pkgs)

