class DiskPage(BasePage):
    def __init__(self, window):
        super().__init__(window)
        self.add_title("Where should Wagashi live?")
        self.add_subtitle("Everything on the selected disk will be replaced.")

        self.disk_group = QButtonGroup()
        self.disk_buttons = []

        disks = self.get_disks()
        for i, (name, size, model) in enumerate(disks):
            rb = QRadioButton(f"/dev/{name}   {size}   {model}")
            if i == 0:
                rb.setChecked(True)
            self.disk_group.addButton(rb, i)
            self.disk_buttons.append((name, rb))
            self.layout.addWidget(rb)
            self.layout.addSpacing(4)

        self.layout.addSpacing(40)
        self.add_section("setup")
        self.layout_group = QButtonGroup()
        for i, (key, label, desc) in enumerate([
            ("simple",    "Simple",    "everything together. easy and works great."),
            ("separated", "Separated", "home folder gets its own space. good if you reinstall often."),
            ("encrypted", "Encrypted", "everything locked with a password. maximum privacy."),
        ]):
            row = QHBoxLayout()
            rb = QRadioButton()
            if i == 0:
                rb.setChecked(True)
            self.layout_group.addButton(rb, i)
            row.addWidget(rb)
            text = QVBoxLayout()
            l1 = QLabel(label)
            l1.setStyleSheet(f"font-size: 14px; color: {COLORS['text']}; background: transparent;")
            l2 = QLabel(desc)
            l2.setStyleSheet(f"font-size: 12px; color: {COLORS['text_dim']}; background: transparent;")
            text.addWidget(l1)
            text.addWidget(l2)
            row.addLayout(text)
            row.addStretch()
            self.layout.addLayout(row)
            self.layout.addSpacing(8)

        self.add_nav(next_fn=self.save)

    def get_disks(self):
        result = subprocess.run("lsblk -d -o NAME,SIZE,MODEL,TYPE | grep disk", shell=True, capture_output=True, text=True)
        disks = []
        for line in result.stdout.strip().split("\n"):
            parts = line.split()
            if parts:
                disks.append((parts[0], parts[1], " ".join(parts[2:-1]) or "Unknown"))
        return disks

    def save(self):
        layouts = ["simple", "separated", "encrypted"]
        for name, rb in self.disk_buttons:
            if rb.isChecked():
                self.window.data["disk"] = f"/dev/{name}"
                self.window.data["disk_name"] = name
                break
        self.window.data["layout"] = layouts[self.layout_group.checkedId()]
        self.window.next_page()


class VirtualizationPage(BasePage):
    def __init__(self, window):
        super().__init__(window)
        self.add_title("Ushio.")
        self.add_subtitle("Run other operating systems inside Wagashi.\nOptional, but powerful.")

        self.enable_vm  = QRadioButton("Yes — set up virtualization for me")
        self.disable_vm = QRadioButton("No — I don't need VMs")
        self.disable_vm.setChecked(True)
        self.layout.addWidget(self.enable_vm)
        self.layout.addWidget(self.disable_vm)
        self.layout.addSpacing(40)

        self.gpu_section = QWidget()
        self.gpu_section.setStyleSheet("background: transparent;")
        gpu_layout = QVBoxLayout(self.gpu_section)
        gpu_layout.setContentsMargins(0, 0, 0, 0)

        gpu_label = QLabel("GPU PASSTHROUGH")
        gpu_label.setObjectName("section")
        gpu_layout.addWidget(gpu_label)
        gpu_layout.addSpacing(16)

        self.gpu_nvidia = QRadioButton("My passthrough GPU is NVIDIA")
        self.gpu_amd    = QRadioButton("My passthrough GPU is AMD")
        self.gpu_auto   = QRadioButton("Find out for me")
        self.gpu_none   = QRadioButton("No passthrough")
        self.gpu_none.setChecked(True)

        for rb in [self.gpu_nvidia, self.gpu_amd, self.gpu_auto, self.gpu_none]:
            gpu_layout.addWidget(rb)
            gpu_layout.addSpacing(4)

        self.gpu_section.setVisible(False)
        self.layout.addWidget(self.gpu_section)
        self.enable_vm.toggled.connect(lambda checked: self.gpu_section.setVisible(checked))
        self.add_nav(next_fn=self.save)

    def save(self):
        self.window.data["virtualization"] = self.enable_vm.isChecked()
        if self.enable_vm.isChecked():
            if self.gpu_nvidia.isChecked():   self.window.data["gpu_passthrough"] = "nvidia"
            elif self.gpu_amd.isChecked():    self.window.data["gpu_passthrough"] = "amd"
            elif self.gpu_auto.isChecked():   self.window.data["gpu_passthrough"] = "auto"
            else:                             self.window.data["gpu_passthrough"] = "none"
        self.window.next_page()


