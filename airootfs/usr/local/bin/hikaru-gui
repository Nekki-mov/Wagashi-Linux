        self.layout.addStretch()
        begin_text = {"en": "begin", "es": "comenzar", "ja": "始める"}.get(window.lang, "begin")
        self.add_nav(back=False, next_text=begin_text)


class NetworkPage(BasePage):
    def __init__(self, window):
        super().__init__(window)
        T = window.T
        connection_title = {"en": "Connection.", "es": "Conexión.", "ja": "接続。"}.get(window.lang, "Connection.")
        self.add_title(connection_title)

        self.status = QLabel(T["NETWORK_CHECKING"])
        self.status.setObjectName("subtitle")
        self.status.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.layout.addWidget(self.status)
        self.layout.addSpacing(16)

        self.wifi_widget = QWidget()
        wifi_lay = QVBoxLayout(self.wifi_widget)
        wifi_lay.setContentsMargins(0, 0, 0, 0)
        wifi_lay.setSpacing(10)

        self.wifi_networks_label = QLabel(T["NETWORK_WIFI_NETWORKS"])
        self.wifi_networks_label.setObjectName("section")
        wifi_lay.addWidget(self.wifi_networks_label)

        self.wifi_list = QListWidget()
        self.wifi_list.setFixedHeight(150)
        wifi_lay.addWidget(self.wifi_list)

        self.wifi_password = QLineEdit()
        self.wifi_password.setEchoMode(QLineEdit.EchoMode.Password)
        self.wifi_password.setPlaceholderText(T["NETWORK_WIFI_PASSWORD"])
        wifi_lay.addWidget(self.wifi_password)

        btn_row = QHBoxLayout()
        self.scan_btn = QPushButton(T["NETWORK_WIFI_SCAN"])
        self.scan_btn.setObjectName("secondary")
        self.scan_btn.clicked.connect(self._scan_wifi)
        btn_row.addWidget(self.scan_btn)

        self.connect_btn = QPushButton(T["NETWORK_WIFI_CONNECT"])
        self.connect_btn.setObjectName("primary")
        self.connect_btn.clicked.connect(self._connect_wifi)
        btn_row.addWidget(self.connect_btn)
        wifi_lay.addLayout(btn_row)

        self.wifi_error = QLabel("")
        self.wifi_error.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.wifi_error.setStyleSheet(f"color: {COLORS['error']}; font-size: 12px;")
        wifi_lay.addWidget(self.wifi_error)

        self.wifi_widget.hide()
        self.layout.addWidget(self.wifi_widget)
        self.layout.addStretch()
        self.add_nav()
        QTimer.singleShot(600, self.check)

    def check(self):
        T = self.window.T
        result = subprocess.run("ping -c 1 -W 2 1.1.1.1", shell=True, capture_output=True)
        if result.returncode == 0:
            self.status.setText(f"✦ {T['NETWORK_OK']}")
            self.status.setStyleSheet(f"color: {COLORS['accent']}; background: transparent; font-size: 14px;")
            self.wifi_widget.hide()
        else:
            self.status.setText(T["NETWORK_FAIL"])
            self.status.setStyleSheet(f"color: {COLORS['error']}; background: transparent; font-size: 14px;")
            self._scan_wifi()

    def _scan_wifi(self):
        T = self.window.T
        self.wifi_error.setText(T["NETWORK_WIFI_SCANNING"])
        self.wifi_list.clear()
        result = subprocess.run("nmcli -t -f SSID dev wifi list", shell=True, capture_output=True, text=True)
        networks = []
        for line in result.stdout.strip().split("\n"):
            ssid = line.strip()
            if ssid and ssid not in networks:
                networks.append(ssid)
                self.wifi_list.addItem(ssid)
        self.wifi_error.setText("")
        if networks:
            self.wifi_widget.show()
        else:
            self.wifi_error.setText(T["NETWORK_WIFI_NONE"])
            self.wifi_widget.show()

    def _connect_wifi(self):
        T = self.window.T
        selected = self.wifi_list.currentItem()
        if not selected:
            return
        ssid = selected.text()
        password = self.wifi_password.text()
        self.connect_btn.setEnabled(False)
        self.connect_btn.setText(T["NETWORK_WIFI_SCANNING"])
        self.wifi_error.setText("")
        if password:
            cmd = ["nmcli", "dev", "wifi", "connect", ssid, "password", password]
        else:
            cmd = ["nmcli", "dev", "wifi", "connect", ssid]
        result = subprocess.run(cmd, capture_output=True, text=True)
        self.connect_btn.setText(T["NETWORK_WIFI_CONNECT"])
        self.connect_btn.setEnabled(True)
        if result.returncode == 0:
            self.wifi_widget.hide()
            self.status.setText(f"✦ {T['NETWORK_WIFI_CONNECTED']}")
            self.status.setStyleSheet(f"color: {COLORS['accent']}; background: transparent; font-size: 14px;")
        else:
            self.wifi_error.setText(T["NETWORK_WIFI_CONNECT_FAIL"])

class UserPage(BasePage):
    def __init__(self, window):
        super().__init__(window)
        T = window.T
        self.add_title(T["USER_INTRO"])
        self.add_subtitle(T["WELCOME_2"])

        self.add_section(T["SUMMARY_USER"])
        self.username = QLineEdit()
        self.username.setPlaceholderText(T["USER_USERNAME_RETRY"])
        self.layout.addWidget(self.username)
        self.layout.addSpacing(32)

        self.add_section(T["USER_PASSWORD_PROMPT"])
        self.password = QLineEdit()
        self.password.setEchoMode(QLineEdit.EchoMode.Password)
        self.password.setPlaceholderText("••••••••")
        self.layout.addWidget(self.password)
        self.layout.addSpacing(12)

        self.password2 = QLineEdit()
        self.password2.setEchoMode(QLineEdit.EchoMode.Password)
        self.password2.setPlaceholderText(T["USER_PASSWORD_CONFIRM"])
        self.layout.addWidget(self.password2)
        self.layout.addSpacing(32)

        self.add_section(T["USER_HOSTNAME_PROMPT"])
        self.hostname = QLineEdit()
        self.hostname.setPlaceholderText("wagashi")
        self.layout.addWidget(self.hostname)

        self.error = QLabel("")
        self.error.setObjectName("error")
        self.error.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.layout.addSpacing(16)
        self.layout.addWidget(self.error)

        self.add_nav(next_fn=self.validate)

    def validate(self):
        T = self.window.T
        u = self.username.text().strip()
        p = self.password.text()
        p2 = self.password2.text()
        if not u or not u.replace("-", "").replace("_", "").isalnum() or u[0].isdigit():
            self.error.setText(T["USER_USERNAME_ERROR"])
            return
        if not p:
            self.error.setText(T["USER_PASSWORD_ERROR"])
            return
        if p != p2:
            self.error.setText(T["USER_PASSWORD_ERROR"])
            return
        self.window.data["username"] = u
        self.window.data["password"] = p
        self.window.data["hostname"] = self.hostname.text().strip() or "wagashi"
        self.error.setText("")
        self.window.next_page()


class KeyboardPage(BasePage):
    def __init__(self, window):
        super().__init__(window)
        T = window.T
        self.add_title(T["KEYBOARD_ASK"])
        self.add_subtitle("")

        options = [
            ("us",        T["KEYBOARD_US"],    ""),
            ("es",        T["KEYBOARD_ES"],    ""),
            ("uk",        T["KEYBOARD_UK"],    ""),
            ("fr",        T["KEYBOARD_FR"],    ""),
            ("de",        T["KEYBOARD_DE"],    ""),
            ("it",        T["KEYBOARD_IT"],    ""),
            ("pt-latin1", T["KEYBOARD_PT"],    ""),
            ("jp106",     T["KEYBOARD_JA"],    ""),
            ("other",     T["KEYBOARD_OTHER"], ""),
        ]

        self.buttons = {}
        self.layout_group = QButtonGroup()
        for i, (key, label, desc) in enumerate(options):
            row = QHBoxLayout()
            rb = QRadioButton()
            self.buttons[key] = rb
            self.layout_group.addButton(rb, i)
            row.addWidget(rb)
            text = QVBoxLayout()
            l1 = QLabel(label)
            l1.setStyleSheet(f"font-size: 14px; color: {COLORS['text']}; background: transparent;")
            text.addWidget(l1)
            if desc:
                l2 = QLabel(desc)
                l2.setStyleSheet(f"font-size: 12px; color: {COLORS['text_dim']}; background: transparent;")
                text.addWidget(l2)
            row.addLayout(text)
            row.addStretch()
            self.layout.addLayout(row)
            self.layout.addSpacing(4)

        default_keyboard = "jp106" if window.lang == "ja" else "us"
        self.buttons[default_keyboard].setChecked(True)
        self.other_input = QLineEdit()
        self.other_input.setPlaceholderText(T["KEYBOARD_OTHER_PROMPT"])
        self.other_input.setVisible(False)
        self.layout.addWidget(self.other_input)
        self.buttons["other"].toggled.connect(self.other_input.setVisible)
        self.add_nav(next_fn=self.save)

    def save(self):
        for key, btn in self.buttons.items():
            if btn.isChecked():
                self.window.data["keyboard"] = self.other_input.text().strip() or "us" if key == "other" else key
                break
        layout = self.window.data.get("keyboard", "us")
        x11_map = {"es": "es", "uk": "gb", "fr": "fr", "de": "de", "it": "it", "pt-latin1": "pt", "jp106": "jp", "us": "us"}
        x11_layout = x11_map.get(layout, layout)
        layout_index = {"us": 0, "es": 1, "gb": 2, "fr": 3, "de": 4, "it": 5, "pt": 6, "jp": 7}.get(x11_layout, 0)
        subprocess.run(["setxkbmap", x11_layout], capture_output=True)
        subprocess.run(["localectl", "set-x11-keymap", x11_layout], capture_output=True)
        subprocess.run(["qdbus6", "org.kde.keyboard", "/Layouts", "org.kde.KeyboardLayouts.setLayout", str(layout_index)], capture_output=True)
        self.window.next_page()


