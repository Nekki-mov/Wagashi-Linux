        self.layout.addWidget(self.firewall)
        self.layout.addSpacing(16)

        self.updates = QCheckBox("Check for updates automatically.")
        self.updates.setChecked(True)
        self.layout.addWidget(self.updates)

        self.add_nav(next_fn=self.save)

    def save(self):
