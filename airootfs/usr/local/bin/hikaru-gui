class NetworkPage(BasePage):
    def __init__(self, window):
        super().__init__(window)
        self.add_title("Let's check your connection.")
        self.add_subtitle("Wagashi needs internet to download packages.")
        self.layout.addStretch()

        self.status = QLabel("Checking...")
        self.status.setStyleSheet(f"color: {COLORS['text_dim']}; background: transparent;")
        self.layout.addWidget(self.status)
        self.layout.addStretch()

        self.add_nav()
        QTimer.singleShot(500, self.check)

    def check(self):
        result = subprocess.run("ping -c 1 -W 1 1.1.1.1", shell=True, capture_output=True)
        if result.returncode == 0:
            self.status.setText("✦ You're connected. Good.")
            self.status.setStyleSheet(f"color: {COLORS['accent']}; background: transparent;")
        else:
            self.status.setText("✦ No connection found. You can continue, but installation may fail.")
            self.status.setStyleSheet(f"color: {COLORS['coral']}; background: transparent;")


class UserPage(BasePage):
    def __init__(self, window):
        super().__init__(window)
        self.add_title("Now, let's talk about you.")
        self.add_subtitle("Just a few basics.")

        self.add_section("Username")
        self.username = QLineEdit()
        self.username.setPlaceholderText("lowercase, no spaces")
        self.layout.addWidget(self.username)
        self.layout.addSpacing(24)

        self.add_section("Password")
        self.password = QLineEdit()
        self.password.setEchoMode(QLineEdit.EchoMode.Password)
        self.password.setPlaceholderText("something you'll remember")
        self.layout.addWidget(self.password)
        self.layout.addSpacing(12)

        self.password2 = QLineEdit()
        self.password2.setEchoMode(QLineEdit.EchoMode.Password)
        self.password2.setPlaceholderText("again")
        self.layout.addWidget(self.password2)
        self.layout.addSpacing(24)

        self.add_section("Computer name")
        self.hostname = QLineEdit()
        self.hostname.setPlaceholderText("wagashi")
        self.layout.addWidget(self.hostname)

        self.error = QLabel("")
        self.error.setStyleSheet(f"color: {COLORS['coral']}; background: transparent;")
        self.layout.addSpacing(12)
        self.layout.addWidget(self.error)

        self.add_nav(next_fn=self.validate)

    def validate(self):
        u = self.username.text().strip()
        p = self.password.text()
        p2 = self.password2.text()

        if not u or not u.replace("-", "").replace("_", "").isalnum() or u[0].isdigit():
            self.error.setText("✦ Lowercase only — it's a Linux thing, not us being difficult.")
            return
        if not p:
            self.error.setText("✦ You'll need a password.")
            return
        if p != p2:
            self.error.setText("✦ Those don't match.")
            return

        self.window.data["username"] = u
        self.window.data["password"] = p
        self.window.data["hostname"] = self.hostname.text().strip() or "wagashi"
        self.error.setText("")
        self.window.next_page()


class KeyboardPage(BasePage):
    def __init__(self, window):
        super().__init__(window)
        self.add_title("What keyboard layout are you using?")
        self.add_subtitle("We'll set it up so everything just works.")

        options = [
            ("us",        "US / English",   "default"),
            ("es",        "Spanish",        ""),
            ("uk",        "UK / British",   ""),
            ("fr",        "French",         ""),
            ("de",        "German",         ""),
            ("it",        "Italian",        ""),
            ("pt-latin1", "Portuguese",     ""),
            ("other",     "Other",          "I'll configure it manually later"),
        ]

        self.buttons = {}
        self.layout_group = QButtonGroup()
        for i, (key, label, desc) in enumerate(options):
            row = QHBoxLayout()
            rb = QRadioButton()
            self.buttons[key] = rb
            self.layout_group.addButton(rb, i)
            row.addWidget(rb)

            text = QVBoxLayout()
            l1 = QLabel(label)
            l1.setStyleSheet("font-size: 15px; color: #ffffff; background: transparent;")
            text.addWidget(l1)
            if desc:
                l2 = QLabel(desc)
                l2.setStyleSheet(f"font-size: 12px; color: {COLORS['text_dim']}; background: transparent;")
                text.addWidget(l2)
            row.addLayout(text)
            row.addStretch()
            self.layout.addLayout(row)
            self.layout.addSpacing(4)

        self.buttons["us"].setChecked(True)

        self.other_input = QLineEdit()
        self.other_input.setPlaceholderText("layout code (e.g. dvorak, colemak)")
        self.other_input.setVisible(False)
        self.layout.addWidget(self.other_input)
        self.buttons["other"].toggled.connect(self.other_input.setVisible)

        self.add_nav(next_fn=self.save)

    def save(self):
        for key, btn in self.buttons.items():
            if btn.isChecked():
                if key == "other":
                    self.window.data["keyboard"] = self.other_input.text().strip() or "us"
                else:
                    self.window.data["keyboard"] = key
                break
        self.window.next_page()


class TimezonePage(BasePage):
    def __init__(self, window):
        super().__init__(window)
        self.add_title("Roughly, where are you?")
        self.add_subtitle("We'll set your clock accordingly.")

        continents = {
            "Europe":    "Europe",
            "America":   "Americas",
            "Asia":      "Asia",
            "Africa":    "Africa",
            "Australia": "Australia / Oceania",
            "UTC":       "I don't know — keep it simple (UTC)",
        }

        self.continent_group = QButtonGroup()
        self.continent_buttons = {}
        for i, (key, label) in enumerate(continents.items()):
            rb = QRadioButton(label)
            self.continent_group.addButton(rb, i)
            self.continent_buttons[key] = rb
            self.layout.addWidget(rb)
            self.layout.addSpacing(4)

        self.continent_buttons["Europe"].setChecked(True)

        self.layout.addSpacing(24)
        self.add_section("City")
        self.city_input = QLineEdit()
        self.city_input.setPlaceholderText("Madrid, London, New_York, Tokyo...")
        self.layout.addWidget(self.city_input)

        note = QLabel("Leave empty to use UTC.")
        note.setStyleSheet(f"color: {COLORS['text_dim']}; font-size: 12px; background: transparent;")
        self.layout.addSpacing(8)
        self.layout.addWidget(note)

        self.add_nav(next_fn=self.save)

    def save(self):
        for key, btn in self.continent_buttons.items():
            if btn.isChecked():
                continent = key
                break
        if continent == "UTC":
            self.window.data["timezone"] = "UTC"
        else:
            city = self.city_input.text().strip()
            self.window.data["timezone"] = f"{continent}/{city}" if city else "UTC"
        self.window.next_page()


