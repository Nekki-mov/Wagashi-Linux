# ── GPU utils ──────────────────────────────────────────────────────────────────
def _detect_cpu_vendor():
    result = subprocess.run("grep -m1 'vendor_id' /proc/cpuinfo", shell=True, capture_output=True, text=True)
    return "amd" if "AuthenticAMD" in result.stdout else "intel"

def _get_gpus():
    result = subprocess.run("lspci -nn | grep -E 'VGA|3D|Display'", shell=True, capture_output=True, text=True)
    gpus = []
    for line in result.stdout.strip().split("\n"):
        if not line:
            continue
        pci_addr = line.split()[0]
        vendor = "nvidia" if "NVIDIA" in line.upper() else "amd" if ("AMD" in line.upper() or "ATI" in line.upper()) else "other"
        match = _re.search(r'\[([0-9a-f]{4}:[0-9a-f]{4})\]', line)
        device_id = match.group(1) if match else "unknown"
        gpus.append((pci_addr, vendor, device_id, line.strip()))
    return gpus

def _resolve_gpu_auto(gpu_choice, ask_fn=None):
    gpus = _get_gpus()
    if not gpus or gpu_choice == "none":
        return None
    if gpu_choice in ("nvidia", "amd"):
        candidates = [(a, v, d, l) for a, v, d, l in gpus if v == gpu_choice]
        if not candidates:
            return None
        if len(candidates) == 1:
            return candidates[0][0], candidates[0][1], candidates[0][2]
        if ask_fn:
            idx = ask_fn(candidates)
            return candidates[idx][0], candidates[idx][1], candidates[idx][2]
        return candidates[0][0], candidates[0][1], candidates[0][2]
    if gpu_choice == "auto":
        if len(gpus) <= 1:
            return None
        if ask_fn:
            idx = ask_fn(gpus)
            return gpus[idx][0], gpus[idx][1], gpus[idx][2]
        return gpus[-1][0], gpus[-1][1], gpus[-1][2]
    return None

def purpose_packages(purpose):
    pkgs = []
    if purpose in ("everyday", "everything"):
        pkgs += ["firefox", "vlc"]
    if purpose in ("creative", "gaming_creative", "everything"):
        pkgs += ["krita", "kdenlive", "obs-studio", "inkscape"]
    if purpose in ("dev", "everything"):
        pkgs += ["code", "docker", "python", "nodejs", "npm"]
    if purpose in ("gaming", "gaming_creative", "everything"):
        pkgs += ["steam", "lutris", "wine", "winetricks", "gamemode"]
    return " ".join(pkgs)

# ── Base page ──────────────────────────────────────────────────────────────────
class BasePage(QWidget):
    def __init__(self, window):
        super().__init__()
        self.window = window
        self._outer = QVBoxLayout(self)
        self._outer.setContentsMargins(0, 0, 0, 0)
        self._outer.setSpacing(0)

        self._center = QWidget()
        self._center.setMaximumWidth(640)
        self.layout = QVBoxLayout(self._center)
        self.layout.setContentsMargins(0, 80, 0, 60)
        self.layout.setSpacing(0)

        wrap = QHBoxLayout()
        wrap.addStretch()
        wrap.addWidget(self._center)
        wrap.addStretch()

        self._outer.addLayout(wrap)

    def add_title(self, text):
        label = QLabel(text)
        label.setObjectName("title")
        label.setWordWrap(True)
        label.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.layout.addWidget(label)
        self.layout.addSpacing(12)

    def add_subtitle(self, text):
        label = QLabel(text)
        label.setObjectName("subtitle")
        label.setWordWrap(True)
        label.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.layout.addWidget(label)
        self.layout.addSpacing(48)

    def add_section(self, text):
        label = QLabel(text.upper())
        label.setObjectName("section")
        label.setAlignment(Qt.AlignmentFlag.AlignLeft)
        self.layout.addWidget(label)
        self.layout.addSpacing(12)

    def add_nav(self, back=True, next_text="Continue", next_fn=None):
        self.layout.addStretch()
        self.layout.addSpacing(40)
        row = QHBoxLayout()
        if back:
            btn_back = QPushButton("← back")
            btn_back.setObjectName("secondary")
            btn_back.clicked.connect(self.window.prev_page)
            row.addWidget(btn_back)
        row.addStretch()
        btn_next = QPushButton(next_text)
        btn_next.setObjectName("primary")
        btn_next.clicked.connect(next_fn or self.window.next_page)
        row.addWidget(btn_next)
        self.layout.addLayout(row)

# ── Window ─────────────────────────────────────────────────────────────────────
class HikaruWindow(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Hikaru")
        self.setMinimumSize(900, 600)
        self.setStyleSheet(STYLE)
        self.data = {}
        self.stack = QStackedWidget()
        self.setCentralWidget(self.stack)
        self.pages = [
            WelcomePage(self),
            NetworkPage(self),
            UserPage(self),
            KeyboardPage(self),
            TimezonePage(self),
            PurposePage(self),
            DiskPage(self),
            VirtualizationPage(self),
            SecurityPage(self),
            SummaryPage(self),
            InstallPage(self),
            DonePage(self),
        ]
        for page in self.pages:
            self.stack.addWidget(page)
        self.stack.setCurrentIndex(0)

    def next_page(self):
        i = self.stack.currentIndex()
        if i < len(self.pages) - 1:
            self.stack.setCurrentIndex(i + 1)

    def prev_page(self):
        i = self.stack.currentIndex()
        if i > 0:
            self.stack.setCurrentIndex(i - 1)

