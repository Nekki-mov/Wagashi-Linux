#!/usr/bin/env python3
# Hikaru — Wagashi Linux installer
# "Light of the sky."

import subprocess, sys, os, getpass, time

def clear():
    os.system("clear")

def say(msg, pause=0):
    print(f"\n✦ {msg}")
    if pause: time.sleep(pause)

def ask(prompt, default=None):
    suffix = f" [{default}]" if default else ""
    val = input(f"  {prompt}{suffix} → ").strip()
    return val if val else default

def ask_choice(prompt, options):
    print(f"\n✦ {prompt}\n")
    for i, (key, desc) in enumerate(options.items(), 1):
        print(f"  {i}.  {desc}")
    print()
    while True:
        choice = input("  Your choice → ").strip()
        if choice.isdigit() and 1 <= int(choice) <= len(options):
            return list(options.keys())[int(choice) - 1]
        say("Just the number, please.")

def ask_yes(prompt, default="yes"):
    hint = "[Yes/no]" if default == "yes" else "[yes/No]"
    val = input(f"\n✦ {prompt} {hint} → ").strip().lower()
    if not val:
        return default == "yes"
    return val in ("yes", "y", "sí", "si", "s")

def run(cmd, check=True, capture=False):
    if capture:
        return subprocess.run(cmd, shell=True, capture_output=True, text=True)
    return subprocess.run(cmd, shell=True, check=check)

def check_network():
    result = run("ping -c 1 -W 1 1.1.1.1", check=False, capture=True)
    return result.returncode == 0

def setup_wifi():
    say("Let's get you connected.")
    run("iwctl station wlan0 scan && sleep 2 && iwctl station wlan0 get-networks", check=False)
    ssid = ask("Network name (SSID)")
    if not ssid:
        return False
    password = getpass.getpass(f"  Password for {ssid} → ")
    run(f'iwctl --passphrase "{password}" station wlan0 connect "{ssid}"', check=False)
    time.sleep(3)
    return check_network()

def get_disks():
    result = run("lsblk -d -o NAME,SIZE,MODEL,TYPE | grep disk", capture=True)
    disks = []
    for line in result.stdout.strip().split("\n"):
        parts = line.split()
        if parts:
            disks.append((parts[0], parts[1], " ".join(parts[2:-1]) or "Unknown"))
    return disks

import re as _re

def _detect_cpu_vendor():
    result = run("grep -m1 'vendor_id' /proc/cpuinfo", capture=True)
    return "amd" if "AuthenticAMD" in result.stdout else "intel"

def _get_gpus():
    result = run("lspci -nn | grep -E 'VGA|3D|Display'", capture=True)
    gpus = []
    for line in result.stdout.strip().split("\n"):
        if not line:
            continue
        pci_addr = line.split()[0]
        vendor = "nvidia" if "NVIDIA" in line.upper() else "amd" if ("AMD" in line.upper() or "ATI" in line.upper()) else "other"
        match = _re.search(r'\[([0-9a-f]{4}:[0-9a-f]{4})\]', line)
        device_id = match.group(1) if match else "unknown"
        gpus.append((pci_addr, vendor, device_id, line.strip()))
    return gpus

def _resolve_gpu(gpu_choice):
    gpus = _get_gpus()
    if not gpus or gpu_choice == "none":
        return None
    if gpu_choice in ("nvidia", "amd"):
        candidates = [(a, v, d, l) for a, v, d, l in gpus if v == gpu_choice]
        if not candidates:
            say(f"No {gpu_choice.upper()} GPU found. Skipping passthrough.")
            return None
        if len(candidates) == 1:
            return candidates[0][0], candidates[0][1], candidates[0][2]
        print("\n✦ More than one GPU found. Which one for passthrough?\n")
        for i, (_, _, _, l) in enumerate(candidates, 1):
            print(f"  {i}.  {l}")
        while True:
            c = input("\n  Your choice → ").strip()
            if c.isdigit() and 1 <= int(c) <= len(candidates):
                idx = int(c) - 1
                return candidates[idx][0], candidates[idx][1], candidates[idx][2]
    if gpu_choice == "auto":
        if len(gpus) == 1:
            say("Only one GPU found. You\'ll need a second one for passthrough. (This one has plans.)")
            return None
        discrete = [(a, v, d, l) for a, v, d, l in gpus if not a.startswith("00:02")]
        if len(discrete) == 1:
            a, v, d, l = discrete[0]
            say(f"Detected passthrough GPU: {l}")
            return a, v, d
        print("\n✦ Which GPU should be passed through to VMs?\n")
        for i, (_, _, _, l) in enumerate(gpus, 1):
            print(f"  {i}.  {l}")
        while True:
            c = input("\n  Your choice → ").strip()
            if c.isdigit() and 1 <= int(c) <= len(gpus):
                idx = int(c) - 1
                return gpus[idx][0], gpus[idx][1], gpus[idx][2]
    return None

def _host_gpu_packages():
    result = run("lspci -nn | grep -E 'VGA|3D|Display'", capture=True)
    lines = [l for l in result.stdout.strip().split("\n") if l]
    official, aur = [], []
    for line in lines:
        upper = line.upper()
        if "NVIDIA" in upper:
            if any(x in upper for x in ("RTX", "GTX 16")):
                official.append("nvidia-open-dkms")
            elif any(x in upper for x in ("GTX 9", "GTX 10", "TITAN")):
                official.append("nvidia-dkms")
            else:
                aur.append("nvidia-470xx-dkms")
        elif "AMD" in upper or "ATI" in upper:
            official += ["vulkan-radeon", "libva-mesa-driver"]
        elif "INTEL" in upper:
            official += ["vulkan-intel", "intel-media-driver"]
    return " ".join(sorted(set(official))), " ".join(sorted(set(aur)))

def setup_passthrough(gpu_choice):
    if gpu_choice == "none":
        return
    result = _resolve_gpu(gpu_choice)
    if result is None:
        return
    pci_addr, vendor, device_id = result
    cpu = _detect_cpu_vendor()
    iommu_param = "amd_iommu=on" if cpu == "amd" else "intel_iommu=on"

    say(f"Enabling IOMMU ({iommu_param})...")
    with open("/mnt/etc/default/grub", "r") as f:
        grub = f.read()
    if iommu_param not in grub:
        grub = grub.replace(
            'GRUB_CMDLINE_LINUX_DEFAULT="quiet splash"',
            f'GRUB_CMDLINE_LINUX_DEFAULT="quiet splash {iommu_param} iommu=pt"'
        )
        with open("/mnt/etc/default/grub", "w") as f:
            f.write(grub)

    say("Configuring vfio-pci...")
    with open("/mnt/etc/modprobe.d/vfio.conf", "w") as f:
        f.write(f"options vfio-pci ids={device_id}\n")
        if vendor == "nvidia":
            f.write("softdep nvidia pre: vfio vfio_pci\n")
            f.write("softdep nouveau pre: vfio vfio_pci\n")

    with open("/mnt/etc/mkinitcpio.conf", "r") as f:
        mk = f.read()
    if "vfio_pci" not in mk:
        mk = "MODULES=(vfio_pci vfio vfio_iommu_type1)\n" + mk
        with open("/mnt/etc/mkinitcpio.conf", "w") as f:
            f.write(mk)

    if vendor == "nvidia":
        say("Applying NVIDIA vendor-id patch...")
        with open("/mnt/etc/modprobe.d/nvidia-vfio.conf", "w") as f:
            f.write("options kvm ignore_msrs=1\n")
            f.write("options kvm report_ignored_msrs=0\n")

    run("sync")
    say("Regenerating GRUB and initramfs for passthrough...")
    run("arch-chroot /mnt grub-mkconfig -o /boot/grub/grub.cfg")
    run("arch-chroot /mnt mkinitcpio -P")
    say(f"Ushio — passthrough ready. ({vendor.upper()} @ {pci_addr})")



def purpose_packages(purpose):
    """Returns (official_pkgs_str, aur_pkgs_str)"""
    always_official = [
        "htop", "btop", "gparted", "keepassxc", "okular", "ark", "spectacle",
        "cups", "system-config-printer", "wine", "winetricks",
    ]
    always_aur = ["proton-ge-custom-bin"]

    everyday_official = ["firefox", "libreoffice-fresh", "thunderbird", "vlc", "gimp", "gwenview"]
    everyday_aur = []

    creative_official = [
        "krita", "gimp", "inkscape", "kdenlive", "obs-studio", "blender",
        "audacity", "scribus", "musescore",
    ]
    creative_aur = ["davinci-resolve"]

    dev_official = [
        "code", "git", "base-devel", "docker", "docker-compose", "neovim",
        "github-cli", "nodejs", "dbeaver", "meld",
    ]
    dev_aur = ["postman-bin"]

    gaming_official = ["steam", "lutris", "gamemode", "mangohud", "discord"]
    gaming_aur = ["heroic-games-launcher-bin"]

    mapping = {
        "everyday":        ([everyday_official], [everyday_aur]),
        "creative":        ([creative_official], [creative_aur]),
        "dev":             ([dev_official], [dev_aur]),
        "gaming":          ([gaming_official], [gaming_aur]),
        "gaming_creative": ([gaming_official, creative_official], [gaming_aur, creative_aur]),
        "creative_dev":    ([creative_official, dev_official], [creative_aur, dev_aur]),
        "everything":      ([everyday_official, creative_official, dev_official, gaming_official],
                             [everyday_aur, creative_aur, dev_aur, gaming_aur]),
    }

    off_lists, aur_lists = mapping.get(purpose, ([everyday_official], [everyday_aur]))

    official = list(always_official)
    for o in off_lists:
        official += o

    aur = list(always_aur)
    for a in aur_lists:
        aur += a

    def dedupe(lst):
        seen = set()
        out = []
        for p in lst:
            if p not in seen:
                seen.add(p)
                out.append(p)
        return out

    return " ".join(dedupe(official)), " ".join(dedupe(aur))

def main():
    clear()
    print("""
    ✦ Hikaru
      Light of the sky.
    """)
    time.sleep(1)

    say("Welcome. Let's set up your new computer.")
    say("I'll ask you a few questions. Nothing complicated.", 0.5)

    # Network
    say("First, let's check your connection.")
    if check_network():
        say("You're connected. Good.")
    else:
        say("No internet connection found.")
        has_wifi = run("ip link show wlan0", check=False, capture=True).returncode == 0
        if has_wifi:
            if ask_yes("Would you like to connect to a Wi-Fi network?"):
                if not setup_wifi():
                    say("Couldn't connect. You can continue, but package download may fail.")
        else:
            say("No Wi-Fi detected. Make sure your ethernet cable is plugged in.")
            say("Continuing anyway.")

    # User
    say("Now, let's talk about you.")
    username = ask("What's your username? (lowercase, no spaces)")
    while not username or not username.replace("-", "").replace("_", "").isalnum() or username[0].isdigit():
        say("Lowercase only — it's a Linux thing, not us being difficult.")
        username = ask("Username")

    say(f"Nice. And a password for {username}?")
    while True:
        password = getpass.getpass("  Password → ")
        confirm = getpass.getpass("  Again → ")
        if password == confirm and password:
            break
        say("Those don't match, or the password was empty. Try again.")

    say("What should this computer be called on your network?")
    hostname = ask("Computer name", default="wagashi")

    # Keyboard
    layout = ask_choice("What keyboard layout are you using?", {
        "us":        "US / English (default)",
        "es":        "Spanish",
        "uk":        "UK / British",
        "fr":        "French",
        "de":        "German",
        "it":        "Italian",
        "pt-latin1": "Portuguese",
        "other":     "Other — I'll configure it manually later",
    })
    if layout == "other":
        layout = ask("Layout code (e.g. dvorak, colemak)", default="us")

    # Timezone
    continent = ask_choice("Roughly, where are you?", {
        "Europe":    "Europe",
        "America":   "Americas",
        "Asia":      "Asia",
        "Africa":    "Africa",
        "Australia": "Australia / Oceania",
        "UTC":       "I don't know / keep it simple (UTC)",
    })
    if continent == "UTC":
        timezone = "UTC"
    else:
        say(f"And the city closest to you in {continent}?")
        say("Examples: Madrid, London, New_York, Tokyo, Sao_Paulo")
        city = ask("City", default="London" if continent == "Europe" else "")
        timezone = f"{continent}/{city}"

    # Purpose
    purpose = ask_choice("What's this computer going to be for?", {
        "everyday":        "Everyday life — browsing, watching things, maybe some work.",
        "creative":        "Creative work — design, video, music, photo.",
        "dev":             "Development — code, servers, containers, experiments.",
        "gaming":          "Gaming — games, compatibility, performance.",
        "gaming_creative": "Gaming + Creative — both. because why choose.",
        "creative_dev":    "Creative + Dev — making things and building things.",
        "everything":      "Everything — just put it all in. I'll sort it out later.",
    })

    # Disk
    say("Let's find a home for Wagashi.")
    disks = get_disks()
    if not disks:
        say("No disks found. Something is wrong.")
        sys.exit(1)

    print("\n✦ Available disks:\n")
    for i, (name, size, model) in enumerate(disks, 1):
        print(f"  {i}.  {size}  —  {model}  (/dev/{name})")
    print()

    while True:
        choice = input("  Which disk should Wagashi live on? → ").strip()
        if choice.isdigit() and 1 <= int(choice) <= len(disks):
            disk_name = disks[int(choice) - 1][0]
            disk = f"/dev/{disk_name}"
            break
        say("Just the number next to the disk.")

    # Disk layout
    layout_choice = ask_choice("How would you like to set up the disk?", {
        "simple":    "Simple — everything together. Easy and works great.",
        "separated": "Separated — home folder gets its own space. Good if you reinstall often.",
        "encrypted": "Encrypted — everything locked with a password. Maximum privacy.",
    })

    # Virtualization
    enable_vm = ask_yes("Set up virtualization (Ushio)? Run other OSes inside Wagashi.", default="no")
    gpu_passthrough = "none"
    if enable_vm:
        gpu_passthrough = ask_choice("GPU passthrough — which GPU will you pass to VMs?", {
            "nvidia": "My passthrough GPU is NVIDIA",
            "amd":    "My passthrough GPU is AMD",
            "auto":   "I don't know — find out for me",
            "none":   "I don't want GPU passthrough",
        })

    # Security
    enable_firewall = ask_yes("Enable a firewall? Recommended for most people.")
    enable_auto_updates = ask_yes("Check for updates automatically?")

    # Summary
    clear()
    print(f"""
    ✦ Here's the plan:

      User        {username}
      Computer    {hostname}
      Keyboard    {layout}
      Timezone    {timezone}
      Purpose     {purpose}
      Disk        {disk}
      Setup       {layout_choice}
      Ushio       {"yes" if enable_vm else "no"}
      Firewall    {"yes" if enable_firewall else "no"}
      Auto-update {"yes" if enable_auto_updates else "no"}
    """)

    say("Everything on that disk will be erased and replaced with Wagashi Linux.")
    if not ask_yes("Ready to go?", default="no"):
        say("No worries. Come back when you're ready.")
        sys.exit(0)

    # Installation
    clear()
    say("Starting. This will take a few minutes. (this is the slow part)", 0.5)

    is_nvme = "nvme" in disk_name
    part_efi  = f"{disk}p1" if is_nvme else f"{disk}1"
    part_root = f"{disk}p2" if is_nvme else f"{disk}2"
    part_home = f"{disk}p3" if is_nvme else f"{disk}3"

    say("Preparing the disk...")
    run(f"wipefs -af {disk}")
    run(f"parted -s {disk} mklabel gpt")
    run(f"parted -s {disk} mkpart ESP fat32 1MiB 513MiB")
    run(f"parted -s {disk} set 1 esp on")

    if layout_choice == "separated":
        run(f"parted -s {disk} mkpart root ext4 513MiB 60%")
        run(f"parted -s {disk} mkpart home ext4 60% 100%")
        run(f"mkfs.ext4 -F {part_home}")
    elif layout_choice == "encrypted":
        run(f"parted -s {disk} mkpart root ext4 513MiB 100%")
        say("Setting up encryption. You'll type your disk password now.")
        run(f"cryptsetup luksFormat {part_root}")
        run(f"cryptsetup open {part_root} wagashi_crypt")
        part_root = "/dev/mapper/wagashi_crypt"
    else:
        run(f"parted -s {disk} mkpart root ext4 513MiB 100%")

    say("Formatting...")
    run(f"mkfs.fat -F32 {part_efi}")
    run(f"mkfs.ext4 -F {part_root}")

    say("Mounting...")
    run(f"mount {part_root} /mnt")
    run(f"mount --mkdir {part_efi} /mnt/boot/efi")
    if layout_choice == "separated":
        run(f"mount --mkdir {part_home} /mnt/home")

    say("Installing Wagashi Linux...")
    base_pkgs = (
        "base linux-zen linux-firmware sudo networkmanager grub efibootmgr "
        "zsh nano git curl wget htop unzip tar man-db "
        "pipewire pipewire-pulse wireplumber bluez bluez-utils cups "
        "mesa noto-fonts noto-fonts-emoji ttf-liberation "
        "xorg-server xorg-xwayland "
        "plasma-desktop plasma-pa plasma-nm plasma-firewall plasma-systemmonitor "
        "sddm sddm-kcm discover kscreen powerdevil bluedevil kwallet-pam "
        "breeze breeze-gtk kde-gtk-config "
        "dolphin konsole "
        "python-pyqt6 plymouth"
    )
    extra_official, extra_aur = purpose_packages(purpose)
    gpu_official, gpu_aur = _host_gpu_packages()
    if gpu_official:
        extra_official = f"{extra_official} {gpu_official}".strip()
    if gpu_aur:
        extra_aur = f"{extra_aur} {gpu_aur}".strip()
    run(f"pacstrap /mnt {base_pkgs} {extra_official}".strip())

    say("Configuring your system...")
    run("genfstab -U /mnt >> /mnt/etc/fstab")
    run(f"arch-chroot /mnt ln -sf /usr/share/zoneinfo/{timezone} /etc/localtime")
    run("arch-chroot /mnt hwclock --systohc")
    run(f"echo '{hostname}' > /mnt/etc/hostname")
    run("echo 'en_US.UTF-8 UTF-8' >> /mnt/etc/locale.gen")
    run("arch-chroot /mnt locale-gen")
    run("echo 'LANG=en_US.UTF-8' > /mnt/etc/locale.conf")

    X11_LAYOUT_MAP = {"uk": "gb", "pt-latin1": "pt"}

    if layout != "us":
        run(f"echo 'KEYMAP={layout}' > /mnt/etc/vconsole.conf")
        x11_layout = X11_LAYOUT_MAP.get(layout, layout)
        run("mkdir -p /mnt/etc/X11/xorg.conf.d")
        with open("/mnt/etc/X11/xorg.conf.d/00-keyboard.conf", "w") as f:
            f.write(
                'Section "InputClass"\n'
                '    Identifier "system-keyboard"\n'
                '    MatchIsKeyboard "on"\n'
                f'    Option "XkbLayout" "{x11_layout}"\n'
                'EndSection\n'
            )

    say("Creating your user...")
    run(f"arch-chroot /mnt groupadd -f sddm-bg")
    run("mkdir -p /mnt/etc/skel/.config/plasma-workspace/shutdown")
    run("cp /etc/skel/.config/plasma-org.kde.plasma.desktop-appletsrc /mnt/etc/skel/.config/plasma-org.kde.plasma.desktop-appletsrc")
    run("cp /etc/skel/.config/plasma-workspace/shutdown/sync-sddm-wallpaper.sh /mnt/etc/skel/.config/plasma-workspace/shutdown/sync-sddm-wallpaper.sh")
    run("cp /etc/skel/.config/kdeglobals /mnt/etc/skel/.config/kdeglobals")
    run("mkdir -p /mnt/etc/skel/.config/autostart")
    run("cp /etc/skel/.config/autostart/wagashi-set-wallpaper.sh /mnt/etc/skel/.config/autostart/wagashi-set-wallpaper.sh")
    run("cp /etc/skel/.config/autostart/wagashi-set-wallpaper.desktop /mnt/etc/skel/.config/autostart/wagashi-set-wallpaper.desktop")
    run("chmod +x /mnt/etc/skel/.config/autostart/wagashi-set-wallpaper.sh")
    run(f"arch-chroot /mnt useradd -m -G wheel,sddm-bg -s /bin/zsh {username}")
    run(f"echo '{username}:{password}' | arch-chroot /mnt chpasswd")
    run(f"arch-chroot /mnt mkdir -p /usr/share/sddm/themes/wagashi/backgrounds")
    run(f"arch-chroot /mnt chgrp sddm-bg /usr/share/sddm/themes/wagashi/backgrounds")
    run(f"arch-chroot /mnt chmod 775 /usr/share/sddm/themes/wagashi/backgrounds")
    run("echo '%wheel ALL=(ALL:ALL) ALL' >> /mnt/etc/sudoers")

    if extra_aur:
        say("Setting up a few extra things from the AUR. This takes a moment...")
        run("arch-chroot /mnt pacman -S --noconfirm --needed git base-devel")
        run(
            f"arch-chroot /mnt su {username} -c "
            f"\"git clone https://aur.archlinux.org/yay-bin.git /tmp/yay-bin && "
            f"cd /tmp/yay-bin && makepkg -si --noconfirm\""
        )
        run(
            f"arch-chroot /mnt su {username} -c "
            f"\"yay -S --noconfirm --needed {extra_aur}\""
        )

    say("Installing bootloader...")
    run("arch-chroot /mnt grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=Wagashi")

    run("mkdir -p /mnt/boot/grub/themes/wagashi")
    run("cp -r /usr/share/grub/themes/wagashi/. /mnt/boot/grub/themes/wagashi/")

    with open("/mnt/etc/default/grub", "w") as f:
        f.write(
            'GRUB_DEFAULT=0\n'
            'GRUB_TIMEOUT=5\n'
            'GRUB_DISTRIBUTOR=""\n'
            'GRUB_CMDLINE_LINUX_DEFAULT="quiet splash"\n'
            'GRUB_CMDLINE_LINUX=""\n'
            'GRUB_THEME="/boot/grub/themes/wagashi/theme.txt"\n'
            'GRUB_GFXMODE="1920x1080,auto"\n'
            'GRUB_GFXPAYLOAD_LINUX=keep\n'
        )

    run("sync")
    run("arch-chroot /mnt grub-mkconfig -o /boot/grub/grub.cfg")

    # Sobreescribir theme.txt DESPUÉS de grub-mkconfig — sin PNGs
    with open("/mnt/boot/grub/themes/wagashi/theme.txt", "w") as tf:
        tf.write('# Wagashi Linux GRUB Theme\n# Silence is a design choice.\n\ntitle-text: ""\ndesktop-color: "#000000"\n\n+ label {\n  left = 50%-300\n  top = 38%\n  width = 600\n  height = 40\n  text = "Wagashi Linux"\n  font = "wagashi-36.pf2"\n  color = "#ffffff"\n  align = "center"\n}\n\n+ label {\n  left = 50%-300\n  top = 46%\n  width = 600\n  height = 20\n  text = "your computer, always yours."\n  font = "wagashi-14.pf2"\n  color = "#333333"\n  align = "center"\n}\n\n+ boot_menu {\n  left = 50%-160\n  top = 56%\n  width = 320\n  height = 140\n  item_font = "wagashi-14.pf2"\n  item_color = "#444444"\n  selected_item_color = "#e8a0a0"\n  selected_item_style = "bold"\n  item_height = 32\n  item_padding = 0\n  item_spacing = 4\n  scrollbar = false\n}\n')

    say("Installing dango...")
    run("mkdir -p /mnt/usr/share/wallpapers")
    run("cp -r /usr/share/wallpapers/Wagashi-Ayu-Light /mnt/usr/share/wallpapers/")
    run("cp /usr/local/bin/dango /mnt/usr/local/bin/dango")
    run("chmod +x /mnt/usr/local/bin/dango")
    run("mkdir -p /mnt/usr/lib/systemd/system-sleep")
    run("cp /usr/lib/systemd/system-sleep/wagashi-broadcom-wifi-fix /mnt/usr/lib/systemd/system-sleep/wagashi-broadcom-wifi-fix")
    run("chmod +x /mnt/usr/lib/systemd/system-sleep/wagashi-broadcom-wifi-fix")

    say("Applying Wagashi branding...")
    with open("/mnt/etc/os-release", "w") as f:
        f.write('NAME="Wagashi Linux"\n')
        f.write('PRETTY_NAME="Wagashi Linux"\n')
        f.write('ID=wagashi\n')
        f.write('ID_LIKE=arch\n')
        f.write('BUILD_ID=rolling\n')
        f.write('ANSI_COLOR="1;35"\n')
        f.write('HOME_URL="https://wagashi.rednek.org"\n')
        f.write('LOGO=wagashi\n')

    with open("/mnt/etc/motd", "w") as f:
        f.write('Welcome to Wagashi Linux.\n')
        f.write('Your computer, always yours.\n')

    say("Installing Plymouth theme...")
    run("mkdir -p /mnt/usr/share/plymouth/themes/wagashi")
    run("cp -r /usr/share/plymouth/themes/wagashi/. /mnt/usr/share/plymouth/themes/wagashi/")

    with open("/mnt/etc/mkinitcpio.conf", "w") as f:
        f.write('HOOKS=(base udev plymouth autodetect microcode modconf kms block filesystems keyboard fsck)\n')

    run("arch-chroot /mnt plymouth-set-default-theme wagashi")

    say("Regenerating initramfs...")
    run("arch-chroot /mnt mkinitcpio -P")

    say("Verifying installation...")
    result = run("arch-chroot /mnt ls /boot/vmlinuz-linux-zen", check=False, capture=True)
    if result.returncode != 0:
        say("Something went wrong with the kernel. The installation may not boot.")
        say("You can try again or check the logs.")
    else:
        say("Everything looks good.")

    vm_check = run("systemd-detect-virt", check=False, capture=True)
    if vm_check.stdout.strip() not in ("none", ""):
        say(f"Looks like you're in a virtual machine ({vm_check.stdout.strip()}). That's fine, just so you know.")

    say("Enabling services...")
    run("arch-chroot /mnt systemctl enable NetworkManager sddm bluetooth cups")

    if enable_firewall:
        run("pacstrap /mnt ufw", check=False)
        run("arch-chroot /mnt systemctl enable ufw", check=False)
        run("arch-chroot /mnt ufw --force enable", check=False)

    if enable_vm:
        say("Setting up Ushio...")
        run("pacstrap /mnt qemu-full libvirt virt-manager dnsmasq")
        run("arch-chroot /mnt systemctl enable libvirtd")
        run(f"arch-chroot /mnt usermod -aG libvirt {username}")
        setup_passthrough(gpu_passthrough)

    say("Almost there...", 1)
    time.sleep(2)
    clear()

    print(f"""
    ✦ Done.

      Wagashi Linux is ready.
      Welcome home, {username}.

      Your computer, always yours.

      ✦ You can reboot now.
        Type: reboot
    """)

if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\n\n✦ Interrupted. Nothing was changed.")
        sys.exit(0)
