#!/usr/bin/env python3
# Hikaru — Wagashi Linux installer
# "Light of the sky."

import subprocess, sys, os, getpass, time, re as _re
from hikaru_strings import STRINGS

# ── Language selection ────────────────────────────────────────────────────────
def select_language():
    os.system("clear")
    print("\n\n  1.  English")
    print("  2.  Español")
    print("  3.  日本語")
    print()
    while True:
        choice = input("  → ").strip()
        if choice == "1": return "en"
        if choice == "2": return "es"
        if choice == "3": return "ja"

lang = select_language()
T = STRINGS[lang]

# ── Helpers ───────────────────────────────────────────────────────────────────
def clear():
    os.system("clear")

def say(msg, pause=0):
    print(f"\n✦ {msg}")
    if pause: time.sleep(pause)

def ask(prompt, default=None):
    suffix = f" [{default}]" if default else ""
    val = input(f"  {prompt}{suffix} → ").strip()
    return val if val else default

def ask_choice(prompt, options):
    print(f"\n✦ {prompt}\n")
    for i, (key, desc) in enumerate(options.items(), 1):
        print(f"  {i}.  {desc}")
    print()
    while True:
        choice = input(f"  {T['CHOICE_PROMPT']} → ").strip()
        if choice.isdigit() and 1 <= int(choice) <= len(options):
            return list(options.keys())[int(choice) - 1]
        say(T["CHOICE_ERROR"])

def ask_yes(prompt, default="yes"):
    hint = T["YES_NO_YES"] if default == "yes" else T["YES_NO_NO"]
    val = input(f"\n✦ {prompt} {hint} → ").strip().lower()
    if not val:
        return default == "yes"
    return val in ("yes", "y", "sí", "si", "s", "はい")

def run(cmd, check=True, capture=False):
    if capture:
        return subprocess.run(cmd, shell=True, capture_output=True, text=True)
    return subprocess.run(cmd, shell=True, check=check)

# ── Network ───────────────────────────────────────────────────────────────────
def check_network():
    result = run("ping -c 1 -W 1 1.1.1.1", check=False, capture=True)
    return result.returncode == 0

def setup_wifi():
    say(T["NETWORK_WIFI_CONNECTING"])
    run("nmcli dev wifi rescan", check=False)
    time.sleep(2)
    result = run("nmcli -t -f SSID dev wifi list", check=False, capture=True)
    networks = []
    for line in result.stdout.strip().split("\n"):
        ssid = line.strip()
        if ssid and ssid not in networks:
            networks.append(ssid)
            print(f"  · {ssid}")
    ssid = ask(T["NETWORK_WIFI_SSID"])
    if not ssid:
        return False
    password = getpass.getpass(f"  → ")
    if password:
        run(f'nmcli dev wifi connect "{ssid}" password "{password}"', check=False)
    else:
        run(f'nmcli dev wifi connect "{ssid}"', check=False)
    time.sleep(3)
    return check_network()

# ── Disk ──────────────────────────────────────────────────────────────────────
def get_disks():
    result = run("lsblk -d -o NAME,SIZE,MODEL,TYPE | grep disk", capture=True)
    disks = []
    for line in result.stdout.strip().split("\n"):
        parts = line.split()
        if parts:
            disks.append((parts[0], parts[1], " ".join(parts[2:-1]) or "Unknown"))
    return disks

# ── GPU / Ushio ───────────────────────────────────────────────────────────────
def _detect_cpu_vendor():
    result = run("grep -m1 'vendor_id' /proc/cpuinfo", capture=True)
    return "amd" if "AuthenticAMD" in result.stdout else "intel"

def _get_gpus():
    result = run("lspci -nn | grep -E 'VGA|3D|Display'", capture=True)
    gpus = []
    for line in result.stdout.strip().split("\n"):
        if not line:
            continue
        pci_addr = line.split()[0]
        vendor = "nvidia" if "NVIDIA" in line.upper() else "amd" if ("AMD" in line.upper() or "ATI" in line.upper()) else "other"
        match = _re.search(r'\[([0-9a-f]{4}:[0-9a-f]{4})\]', line)
        device_id = match.group(1) if match else "unknown"
        gpus.append((pci_addr, vendor, device_id, line.strip()))
    return gpus

def _resolve_gpu(gpu_choice):
    gpus = _get_gpus()
    if not gpus or gpu_choice == "none":
        return None
    if gpu_choice in ("nvidia", "amd"):
        candidates = [(a, v, d, l) for a, v, d, l in gpus if v == gpu_choice]
        if not candidates:
            say(T["USHIO_GPU_NOT_FOUND"].format(vendor=gpu_choice.upper()))
            return None
        if len(candidates) == 1:
            return candidates[0][0], candidates[0][1], candidates[0][2]
        print(f"\n✦ {T['USHIO_GPU_WHICH']}\n")
        for i, (_, _, _, l) in enumerate(candidates, 1):
            print(f"  {i}.  {l}")
        while True:
            c = input(f"\n  {T['CHOICE_PROMPT']} → ").strip()
            if c.isdigit() and 1 <= int(c) <= len(candidates):
                idx = int(c) - 1
                return candidates[idx][0], candidates[idx][1], candidates[idx][2]
    if gpu_choice == "auto":
        if len(gpus) == 1:
            say(T["USHIO_GPU_ONE"])
            return None
        discrete = [(a, v, d, l) for a, v, d, l in gpus if not a.startswith("00:02")]
        if len(discrete) == 1:
            a, v, d, l = discrete[0]
            say(T["USHIO_GPU_DETECTED"].format(gpu=l))
            return a, v, d
        print(f"\n✦ {T['USHIO_GPU_WHICH']}\n")
        for i, (_, _, _, l) in enumerate(gpus, 1):
            print(f"  {i}.  {l}")
        while True:
            c = input(f"\n  {T['CHOICE_PROMPT']} → ").strip()
            if c.isdigit() and 1 <= int(c) <= len(gpus):
                idx = int(c) - 1
                return gpus[idx][0], gpus[idx][1], gpus[idx][2]
    return None

def setup_passthrough(gpu_choice):
    if gpu_choice == "none":
        return
    result = _resolve_gpu(gpu_choice)
    if result is None:
        return
    pci_addr, vendor, device_id = result
    cpu = _detect_cpu_vendor()
    iommu_param = "amd_iommu=on" if cpu == "amd" else "intel_iommu=on"

    say(T["USHIO_IOMMU"].format(param=iommu_param))
    with open("/mnt/etc/default/grub", "r") as f:
        grub = f.read()
    if iommu_param not in grub:
        grub = grub.replace(
            'GRUB_CMDLINE_LINUX_DEFAULT="quiet splash"',
            f'GRUB_CMDLINE_LINUX_DEFAULT="quiet splash {iommu_param} iommu=pt"'
        )
        with open("/mnt/etc/default/grub", "w") as f:
            f.write(grub)

    say(T["USHIO_VFIO"])
    with open("/mnt/etc/modprobe.d/vfio.conf", "w") as f:
        f.write(f"options vfio-pci ids={device_id}\n")
        if vendor == "nvidia":
            f.write("softdep nvidia pre: vfio vfio_pci\n")
            f.write("softdep nouveau pre: vfio vfio_pci\n")

    with open("/mnt/etc/mkinitcpio.conf", "r") as f:
        mk = f.read()
    if "vfio_pci" not in mk:
        mk = "MODULES=(vfio_pci vfio vfio_iommu_type1)\n" + mk
        with open("/mnt/etc/mkinitcpio.conf", "w") as f:
            f.write(mk)

    if vendor == "nvidia":
        say(T["USHIO_NVIDIA_PATCH"])
        with open("/mnt/etc/modprobe.d/nvidia-vfio.conf", "w") as f:
            f.write("options kvm ignore_msrs=1\n")
            f.write("options kvm report_ignored_msrs=0\n")

    run("sync")
    say(T["USHIO_REBUILD"])
    run("arch-chroot /mnt grub-mkconfig -o /boot/grub/grub.cfg")
    run("arch-chroot /mnt mkinitcpio -P")
    say(T["USHIO_READY"].format(vendor=vendor.upper(), addr=pci_addr))

# ── Purpose packages ──────────────────────────────────────────────────────────
def _host_gpu_packages():
    result = run("lspci -nn | grep -E 'VGA|3D|Display'", capture=True)
    lines = [l for l in result.stdout.strip().split("\n") if l]
    official, aur = [], []
    for line in lines:
        upper = line.upper()
        if "NVIDIA" in upper:
            if any(x in upper for x in ("RTX", "GTX 16")):
                official.append("nvidia-open-dkms")
            elif any(x in upper for x in ("GTX 9", "GTX 10", "TITAN")):
                official.append("nvidia-dkms")
            else:
                aur.append("nvidia-470xx-dkms")
        elif "AMD" in upper or "ATI" in upper:
            official += ["vulkan-radeon", "libva-mesa-driver"]
        elif "INTEL" in upper:
            official += ["vulkan-intel", "intel-media-driver"]
    return " ".join(sorted(set(official))), " ".join(sorted(set(aur)))

def purpose_packages(purpose):
    base = []
    if purpose in ("everyday", "everything"):
        base += ["firefox", "vlc"]
    if purpose in ("creative", "gaming_creative", "everything"):
        base += ["krita", "kdenlive", "obs-studio", "inkscape"]
    if purpose in ("dev", "everything"):
        base += ["code", "docker", "python", "nodejs", "npm"]
    if purpose in ("gaming", "gaming_creative", "everything"):
        base += ["steam", "lutris", "wine", "winetricks", "gamemode"]
    return " ".join(base)

# ── Main ──────────────────────────────────────────────────────────────────────
def main():
    clear()
    print(f"""
    ✦ {T['SPLASH_NAME']}
      {T['SPLASH_SUBTITLE']}
    """)
    time.sleep(1)

    say(T["WELCOME_1"])
    say(T["WELCOME_2"], 0.5)

    # Network
    say(T["NETWORK_CHECKING"])
    if check_network():
        say(T["NETWORK_OK"])
    else:
        say(T["NETWORK_FAIL"])
        has_wifi = run("ip link show wlan0", check=False, capture=True).returncode == 0
        if has_wifi:
            if ask_yes(T["NETWORK_WIFI_ASK"]):
                if not setup_wifi():
                    say(T["NETWORK_WIFI_FAIL"])
        else:
            say(T["NETWORK_NO_WIFI"])
            say(T["NETWORK_CONTINUING"])

    # User
    say(T["USER_INTRO"])
    username = ask(T["USER_USERNAME"])
    while not username or not username.replace("-", "").replace("_", "").isalnum() or username[0].isdigit():
        say(T["USER_USERNAME_ERROR"])
        username = ask(T["USER_USERNAME_RETRY"])

    say(T["USER_PASSWORD"].format(username=username))
    while True:
        password = getpass.getpass(f"  {T['USER_PASSWORD_PROMPT']} → ")
        confirm  = getpass.getpass(f"  {T['USER_PASSWORD_CONFIRM']} → ")
        if password == confirm and password:
            break
        say(T["USER_PASSWORD_ERROR"])

    say(T["USER_HOSTNAME"])
    hostname = ask(T["USER_HOSTNAME_PROMPT"], default="wagashi")

    # Keyboard
    layout = ask_choice(T["KEYBOARD_ASK"], {
        "us":        T["KEYBOARD_US"],
        "es":        T["KEYBOARD_ES"],
        "uk":        T["KEYBOARD_UK"],
        "fr":        T["KEYBOARD_FR"],
        "de":        T["KEYBOARD_DE"],
        "it":        T["KEYBOARD_IT"],
        "pt-latin1": T["KEYBOARD_PT"],
        "jp106":     T["KEYBOARD_JA"],
        "other":     T["KEYBOARD_OTHER"],
    })
    if layout == "other":
        layout = ask(T["KEYBOARD_OTHER_PROMPT"], default="us")

    # Timezone
    continent = ask_choice(T["TIMEZONE_ASK"], {
        "Europe":    T["TIMEZONE_EUROPE"],
        "America":   T["TIMEZONE_AMERICA"],
        "Asia":      T["TIMEZONE_ASIA"],
        "Africa":    T["TIMEZONE_AFRICA"],
        "Australia": T["TIMEZONE_AUSTRALIA"],
        "UTC":       T["TIMEZONE_UTC"],
    })
    if continent == "UTC":
        timezone = "UTC"
    else:
        say(T["TIMEZONE_CITY"].format(continent=continent))
        say(T["TIMEZONE_CITY_EXAMPLES"])
        city = ask(T["TIMEZONE_CITY_PROMPT"], default="London" if continent == "Europe" else "")
        timezone = f"{continent}/{city}"

    # Purpose
    purpose = ask_choice(T["PURPOSE_ASK"], {
        "everyday":        T["PURPOSE_EVERYDAY"],
        "creative":        T["PURPOSE_CREATIVE"],
        "dev":             T["PURPOSE_DEV"],
        "gaming":          T["PURPOSE_GAMING"],
        "gaming_creative": T["PURPOSE_GAMING_CREATIVE"],
        "everything":      T["PURPOSE_EVERYTHING"],
    })

    # Disk
    say(T["DISK_INTRO"])
    disks = get_disks()
    if not disks:
        say(T["DISK_NONE"])
        sys.exit(1)

    print(f"\n✦ {T['DISK_LIST_TITLE']}\n")
    for i, (name, size, model) in enumerate(disks, 1):
        print(f"  {i}.  {size}  —  {model}  (/dev/{name})")
    print()

    while True:
        choice = input(f"  {T['DISK_ASK']} → ").strip()
        if choice.isdigit() and 1 <= int(choice) <= len(disks):
            disk_name = disks[int(choice) - 1][0]
            disk = f"/dev/{disk_name}"
            disk_display = f"{disks[int(choice)-1][1]} — {disks[int(choice)-1][2]}"
            break
        say(T["DISK_ERROR"])

    # Disk layout
    layout_choice = ask_choice(T["LAYOUT_ASK"], {
        "simple":    T["LAYOUT_SIMPLE"],
        "separated": T["LAYOUT_SEPARATED"],
        "encrypted": T["LAYOUT_ENCRYPTED"],
    })

    # Ushio
    enable_vm = ask_yes(T["USHIO_ASK"], default="no")
    gpu_passthrough = "none"
    if enable_vm:
        gpu_passthrough = ask_choice(T["USHIO_GPU_ASK"], {
            "nvidia": T["USHIO_GPU_NVIDIA"],
            "amd":    T["USHIO_GPU_AMD"],
            "auto":   T["USHIO_GPU_AUTO"],
            "none":   T["USHIO_GPU_NONE"],
        })

    # Security
    enable_firewall    = ask_yes(T["FIREWALL_ASK"])
    enable_auto_updates = ask_yes(T["UPDATES_ASK"])

    # Summary
    clear()
    print(f"""
    ✦ {T['SUMMARY_TITLE']}

      {T['SUMMARY_USER']:<14}{username}
      {T['SUMMARY_COMPUTER']:<14}{hostname}
      {T['SUMMARY_KEYBOARD']:<14}{layout}
      {T['SUMMARY_TIMEZONE']:<14}{timezone}
      {T['SUMMARY_PURPOSE']:<14}{purpose}
      {T['SUMMARY_DISK']:<14}{disk_display}
      {T['SUMMARY_SETUP']:<14}{layout_choice}
      {T['SUMMARY_USHIO']:<14}{T['SUMMARY_USHIO_DESC']} — {T['SUMMARY_YES'] if enable_vm else T['SUMMARY_NO']}
      {T['SUMMARY_FIREWALL']:<14}{T['SUMMARY_YES'] if enable_firewall else T['SUMMARY_NO']}
      {T['SUMMARY_UPDATES']:<14}{T['SUMMARY_YES'] if enable_auto_updates else T['SUMMARY_NO']}
    """)

    say(T["SUMMARY_WARNING"])
    if not ask_yes(T["SUMMARY_CONFIRM"], default="no"):
        say(T["SUMMARY_CANCEL"])
        sys.exit(0)

    # Installation
    clear()
    say(T["INSTALL_START"], 0.5)

    is_nvme  = "nvme" in disk_name
    part_efi  = f"{disk}p1" if is_nvme else f"{disk}1"
    part_root = f"{disk}p2" if is_nvme else f"{disk}2"
    part_home = f"{disk}p3" if is_nvme else f"{disk}3"

    say(T["INSTALL_DISK"])
    run(f"wipefs -af {disk}")
    run(f"parted -s {disk} mklabel gpt")
    run(f"parted -s {disk} mkpart ESP fat32 1MiB 513MiB")
    run(f"parted -s {disk} set 1 esp on")

    if layout_choice == "separated":
        run(f"parted -s {disk} mkpart root ext4 513MiB 60%")
        run(f"parted -s {disk} mkpart home ext4 60% 100%")
        run(f"mkfs.ext4 -F {part_home}")
    elif layout_choice == "encrypted":
        run(f"parted -s {disk} mkpart root ext4 513MiB 100%")
        say(T["LAYOUT_ENCRYPT_INTRO"])
        run(f"cryptsetup luksFormat {part_root}")
        run(f"cryptsetup open {part_root} wagashi_crypt")
        part_root = "/dev/mapper/wagashi_crypt"
    else:
        run(f"parted -s {disk} mkpart root ext4 513MiB 100%")

    say(T["INSTALL_FORMAT"])
    run(f"mkfs.fat -F32 {part_efi}")
    run(f"mkfs.ext4 -F {part_root}")

    say(T["INSTALL_MOUNT"])
    run(f"mount {part_root} /mnt")
    run(f"mount --mkdir {part_efi} /mnt/boot/efi")
    if layout_choice == "separated":
        run(f"mount --mkdir {part_home} /mnt/home")

    say(T["INSTALL_PACKAGES"])
    base_pkgs = (
        "base linux-zen linux-firmware sudo networkmanager grub efibootmgr "
        "zsh nano git curl wget htop unzip tar man-db "
        "pipewire pipewire-pulse wireplumber bluez bluez-utils cups "
        "mesa noto-fonts noto-fonts-cjk noto-fonts-emoji ttf-liberation ttf-bitstream-vera "
        "xorg-server xorg-xinit xorg-xrandr xorg-xsetroot xorg-xauth xorg-xhost "
        "windowmaker feh rofi rxvt-unicode xterm imlib2 xarchiver mousepad "
        "python-pyqt6 plymouth mochi fwupd alsa-utils v4l-utils"
    )
    extra_official, extra_aur = purpose_packages(purpose)
    gpu_official, gpu_aur = _host_gpu_packages()
    if gpu_official:
        extra_official = f"{extra_official} {gpu_official}".strip()
    if gpu_aur:
        extra_aur = f"{extra_aur} {gpu_aur}".strip()
    run(f"pacstrap /mnt {base_pkgs} {extra_official}".strip())

    say(T["INSTALL_CONFIG"])
    run("genfstab -U /mnt >> /mnt/etc/fstab")
    run(f"arch-chroot /mnt ln -sf /usr/share/zoneinfo/{timezone} /etc/localtime")
    run("arch-chroot /mnt hwclock --systohc")
    run(f"echo '{hostname}' > /mnt/etc/hostname")
    with open("/mnt/etc/hosts", "w") as f:
        f.write(f"127.0.0.1   localhost\n")
        f.write(f"::1         localhost\n")
        f.write(f"127.0.1.1   {hostname}.localdomain {hostname}\n")
    run("echo 'en_US.UTF-8 UTF-8' >> /mnt/etc/locale.gen")
    if lang == "es":
        run("echo 'es_ES.UTF-8 UTF-8' >> /mnt/etc/locale.gen")
    if lang == "ja":
        run("echo 'ja_JP.UTF-8 UTF-8' >> /mnt/etc/locale.gen")
    run("arch-chroot /mnt locale-gen")
    locale = "ja_JP.UTF-8" if lang == "ja" else "es_ES.UTF-8" if lang == "es" else "en_US.UTF-8"
    run(f"echo 'LANG={locale}' > /mnt/etc/locale.conf")

    if layout != "us":
        run(f"echo 'KEYMAP={layout}' > /mnt/etc/vconsole.conf")

    say(T["INSTALL_USER"])
    run(f"arch-chroot /mnt useradd -m -G wheel -s /bin/zsh {username}")
    run(f"echo '{username}:{password}' | arch-chroot /mnt chpasswd")
    run(f"echo 'root:{password}' | arch-chroot /mnt chpasswd")
    run("echo '%wheel ALL=(ALL:ALL) ALL' >> /mnt/etc/sudoers")

    # wagashi-firstrun autostart — eliminado de aquí, se escribe después del chown

    # LightDM config
    with open(f"/mnt/home/{username}/.xinitrc", "w") as f:
        f.write("#!/bin/sh\n")
        f.write("exec wmaker\n")
    run(f"chmod +x /mnt/home/{username}/.xinitrc")
    run(f"arch-chroot /mnt chown {username}:{username} /home/{username}/.xinitrc")

    # copiar instaladores al sistema
    run("cp /usr/local/bin/wagashi-firstrun /mnt/usr/local/bin/wagashi-firstrun")
    run("chmod +x /mnt/usr/local/bin/wagashi-firstrun")
    run("mkdir -p /mnt/usr/share/wagashi/wallpapers")
    run("cp -r /usr/share/wagashi/wallpapers/. /mnt/usr/share/wagashi/wallpapers/")
    run("cp /usr/local/bin/hikaru /mnt/usr/local/bin/hikaru")
    run("chmod +x /mnt/usr/local/bin/hikaru")
    run("cp /usr/local/bin/hikaru-gui /mnt/usr/local/bin/hikaru-gui")
    run("chmod +x /mnt/usr/local/bin/hikaru-gui")
    run("cp /usr/local/bin/hikaru_strings.py /mnt/usr/local/bin/hikaru_strings.py")

    say(T["INSTALL_BOOTLOADER"])
    run("arch-chroot /mnt grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=Wagashi")
    run("mkdir -p /mnt/boot/grub/themes/wagashi")
    run("cp -r /usr/share/grub/themes/wagashi/. /mnt/boot/grub/themes/wagashi/")
    with open("/mnt/etc/default/grub", "w") as f:
        f.write(
            'GRUB_DEFAULT=0\nGRUB_TIMEOUT=5\nGRUB_DISTRIBUTOR=""\n'
            'GRUB_CMDLINE_LINUX_DEFAULT="quiet splash"\nGRUB_CMDLINE_LINUX=""\n'
            'GRUB_THEME="/boot/grub/themes/wagashi/theme.txt"\n'
            'GRUB_GFXMODE="1920x1080,auto"\nGRUB_GFXPAYLOAD_LINUX=keep\n'
        )
    run("sync")
    run("arch-chroot /mnt grub-mkconfig -o /boot/grub/grub.cfg")
    with open("/mnt/boot/grub/themes/wagashi/theme.txt", "w") as tf:
        tf.write(
            '# Wagashi Linux GRUB Theme\n# Silence is a design choice.\n\n'
            'title-text: ""\ndesktop-color: "#000000"\n\n'
            '+ label {\n  left = 50%-300\n  top = 38%\n  width = 600\n  height = 40\n'
            '  text = "Wagashi Linux"\n  font = "wagashi-36.pf2"\n  color = "#ffffff"\n  align = "center"\n}\n\n'
            '+ label {\n  left = 50%-300\n  top = 46%\n  width = 600\n  height = 20\n'
            '  text = "your computer, always yours."\n  font = "wagashi-14.pf2"\n  color = "#333333"\n  align = "center"\n}\n\n'
            '+ boot_menu {\n  left = 50%-160\n  top = 56%\n  width = 320\n  height = 140\n'
            '  item_font = "wagashi-14.pf2"\n  item_color = "#444444"\n'
            '  selected_item_color = "#e8a0a0"\n  selected_item_style = "bold"\n'
            '  item_height = 32\n  item_padding = 0\n  item_spacing = 4\n  scrollbar = false\n}\n'
        )

    say(T["INSTALL_DANGO"])
    run("cp /usr/local/bin/dango /mnt/usr/local/bin/dango")
    run("chmod +x /mnt/usr/local/bin/dango")
    run("mkdir -p /mnt/usr/lib/systemd/system-sleep")
    run("cp /usr/lib/systemd/system-sleep/wagashi-broadcom-wifi-fix /mnt/usr/lib/systemd/system-sleep/wagashi-broadcom-wifi-fix")
    run("chmod +x /mnt/usr/lib/systemd/system-sleep/wagashi-broadcom-wifi-fix")

    say(T["INSTALL_BRANDING"])
    with open("/mnt/etc/os-release", "w") as f:
        f.write('NAME="Wagashi Linux"\nPRETTY_NAME="Wagashi Linux - Mishio (Nostalgia)"\n')
        f.write('VERSION="1.0 (Natto)"\nVERSION_ID="1.0"\nVARIANT_ID=mishio\n')
        f.write('ID=wagashi\nID_LIKE=arch\nBUILD_ID=rolling\nANSI_COLOR="1;35"\n')
        f.write('HOME_URL="https://wagashi.neklair.es"\nLOGO=wagashi\n')
    with open("/mnt/etc/motd", "w") as f:
        f.write('Welcome to Wagashi Linux — Mishio (Nostalgia).\nYour computer, always yours.\n')
    run("mkdir -p /mnt/usr/share/pixmaps")
    run("mkdir -p /mnt/usr/share/icons/hicolor/scalable/apps")
    run("cp /usr/share/pixmaps/wagashi.svg /mnt/usr/share/pixmaps/wagashi.svg")
    run("cp /usr/share/icons/hicolor/scalable/apps/wagashi.svg /mnt/usr/share/icons/hicolor/scalable/apps/wagashi.svg")

    say(T["INSTALL_PLYMOUTH"])
    run("mkdir -p /mnt/usr/share/plymouth/themes/wagashi")
    run("cp -r /usr/share/plymouth/themes/wagashi/. /mnt/usr/share/plymouth/themes/wagashi/")
    with open("/mnt/etc/mkinitcpio.conf", "w") as f:
        f.write('HOOKS=(base udev plymouth autodetect microcode modconf kms block filesystems keyboard fsck)\n')
    run("arch-chroot /mnt plymouth-set-default-theme wagashi")

    say(T["INSTALL_INITRAMFS"])
    run("arch-chroot /mnt mkinitcpio -P")

    say(T["INSTALL_VERIFY"])
    result = run("arch-chroot /mnt ls /boot/vmlinuz-linux-zen", check=False, capture=True)
    if result.returncode != 0:
        say(T["INSTALL_VERIFY_FAIL"])
        say(T["INSTALL_VERIFY_FAIL_2"])
    else:
        say(T["INSTALL_VERIFY_OK"])

    vm_check = run("systemd-detect-virt", check=False, capture=True)
    if vm_check.stdout.strip() not in ("none", ""):
        say(T["INSTALL_VM_DETECTED"].format(virt=vm_check.stdout.strip()))

    say(T["INSTALL_SERVICES"])
    run("arch-chroot /mnt systemctl enable NetworkManager lightdm bluetooth cups")
    run("arch-chroot /mnt systemctl --global enable gvfs-daemon", check=False)

    if enable_firewall:
        run("pacstrap /mnt ufw", check=False)
        run("arch-chroot /mnt systemctl enable ufw", check=False)
        run("arch-chroot /mnt ufw --force enable", check=False)

    if enable_vm:
        say(T["USHIO_SETTING_UP"])
        run("pacstrap /mnt qemu-full libvirt virt-manager dnsmasq")
        run("arch-chroot /mnt systemctl enable libvirtd")
        run(f"arch-chroot /mnt usermod -aG libvirt {username}")
        setup_passthrough(gpu_passthrough)

    say(T["INSTALL_ALMOST"], 1)

    # home files — escritos como root, chown via arch-chroot al final
    run(f"mkdir -p /mnt/home/{username}/.config/autostart")
    with open(f"/mnt/home/{username}/.config/autostart/wagashi-firstrun.desktop", "w") as f:
        f.write("[Desktop Entry]\nType=Application\nName=Wagashi First Run\n")
        f.write("Exec=/usr/local/bin/wagashi-firstrun\nIcon=dialog-scripts\nX-LXQT-Need-Tray=false\n")
    with open(f"/mnt/home/{username}/.zshrc", "w") as f:
        f.write('pierogi() { echo "O KURWA"; }\n')
        f.write("calçot() { echo \"Did you know, Hatsune Miku was made by Catalonian people? Yeah, Miku was made by Pompeu Fabra University, so IT'S NOT A FUCKING LEEK, IT'S A CALÇOT, VISCA LA TERRA NOI!\"; }\n")
    # chown dentro del chroot — garantiza permisos correctos
    run(f"arch-chroot /mnt chown -R {username}:{username} /home/{username}")

    time.sleep(2)
    clear()

    print(f"""
    ✦ {T['DONE_TITLE']}

      {T['DONE_READY']}
      {T['DONE_WELCOME'].format(username=username)}

      {T['DONE_TAGLINE']}

      ✦ {T['DONE_REBOOT']}
    """)

if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\n\n✦ ...")
        sys.exit(0)
