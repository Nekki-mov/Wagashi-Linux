#!/bin/bash
[ -f "$HOME/.wagashi-setup-done" ] && exit 0
xdg-user-dirs-update
mkdir -p "$HOME/.config/pcmanfm-qt/lxqt"
cat > "$HOME/.config/pcmanfm-qt/lxqt/settings.conf" << 'CONF'
[Desktop]
Wallpaper=/usr/share/wagashi/wallpapers/Nayuki.png
WallpaperMode=stretch
CONF
touch "$HOME/.wagashi-setup-done"
