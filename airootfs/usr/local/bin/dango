#!/usr/bin/env python3
# dango — Wagashi Linux package manager
# A warm wrapper for pacman and yay.

import subprocess, sys, os

VERSION = "0.2.0"

def say(msg):
    print(f"\n✦ {msg}")

def run(cmd, capture=False):
    if capture:
        return subprocess.run(cmd, shell=True, capture_output=True, text=True)
    return subprocess.run(cmd, shell=True)

def has_yay():
    return run("which yay", capture=True).returncode == 0

def is_live():
    """Detecta si estamos en el entorno live de Wagashi."""
    return os.path.exists("/run/archiso")

def help():
    print("""
  dango — Wagashi Linux package manager

  dango -S  <pkg>     install a package
  dango -R  <pkg>     remove a package
  dango -Rs <pkg>     remove a package and its dependencies
  dango -Sy           sync package databases
  dango -Syu          update everything
  dango -Ss <query>   search for a package
  dango -Si <pkg>     show package info
  dango -Q            list installed packages
  dango -Ql <pkg>     list files owned by a package
  dango -Qi <pkg>     info about an installed package
  dango -Qo <file>    which package owns this file
  dango -Sc           clean package cache
  dango -Scc          clean entire package cache
  dango --version     show version

  Searches pacman and AUR automatically.
  No Flatpak. Intentionally.
    """)

def install(pkg):
    say(f"Looking for {pkg}...")
    if is_live():
        say("Live system detected. Syncing repos first...")
        run("pacman -Sy")
    result = run(f"pacman -S {pkg}")
    if result.returncode != 0:
        if has_yay():
            say("Not in the main repos. Checking AUR...")
            result = run(f"yay -S {pkg}")
            if result.returncode != 0:
                say(f"Couldn't find {pkg}. Maybe it doesn't exist, maybe it's you.")
        else:
            say(f"Couldn't find {pkg}. Maybe it doesn't exist, maybe it's you.")
    else:
        say(f"{pkg} is ready.")

def remove(pkg, with_deps=False):
    say(f"Removing {pkg}...")
    flag = "-Rs" if with_deps else "-R"
    result = run(f"pacman {flag} {pkg}")
    if result.returncode == 0:
        say("Gone. No judgment.")
    else:
        say(f"Couldn't remove {pkg}. It might not be installed.")

def sync():
    if is_live():
        say("Syncing package databases. (Live system — not updating, just syncing.)")
    else:
        say("Syncing package databases...")
    run("pacman -Sy")
    say("Repos are up to date.")

def update():
    if is_live():
        say("You're on a live system. Updates here won't survive a reboot.")
        say("Install Wagashi Linux first, then update from there.")
        return
    say("Checking what's new...")
    run("pacman -Syu")
    if has_yay():
        say("Checking AUR packages too...")
        run("yay -Syu --aur")
    say("All done. Your computer is slightly better now.")

def search(query):
    say(f"Looking for '{query}'...")
    run(f"pacman -Ss {query}")
    if has_yay():
        run(f"yay -Ss {query} --aur")

def info(pkg, installed=False):
    say(f"Here's what I know about {pkg}:")
    flag = "-Qi" if installed else "-Si"
    result = run(f"pacman {flag} {pkg}")
    if result.returncode != 0:
        say(f"Never heard of {pkg}. Try: dango -Ss {pkg}")

def list_installed():
    say("Everything currently installed:")
    run("pacman -Q")

def list_files(pkg):
    say(f"Files owned by {pkg}:")
    result = run(f"pacman -Ql {pkg}")
    if result.returncode != 0:
        say(f"{pkg} doesn't seem to be installed.")

def owns(file):
    say(f"Figuring out who owns {file}...")
    result = run(f"pacman -Qo {file}")
    if result.returncode != 0:
        say(f"Nothing claims to own {file}. Orphan file.")

def clean(full=False):
    if full:
        say("Clearing the entire package cache. No going back.")
        run("pacman -Scc")
    else:
        say("Cleaning up old package versions. Your disk will thank you.")
        run("pacman -Sc")
    say("Done. That feels better.")

def main():
    args = sys.argv[1:]
    if not args or args[0] in ("--help", "-h"):
        help()
        return
    if args[0] == "--version":
        print(f"\n  dango {VERSION} — Wagashi Linux\n")
        return

    flag = args[0]
    pkg = args[1] if len(args) > 1 else ""

    if flag == "-S":
        if not pkg:
            say("Install what, exactly?")
            return
        install(pkg)
    elif flag == "-R":
        if not pkg:
            say("Remove what?")
            return
        remove(pkg, with_deps=False)
    elif flag == "-Rs":
        if not pkg:
            say("Remove what?")
            return
        remove(pkg, with_deps=True)
    elif flag == "-Sy":
        sync()
    elif flag == "-Syu":
        update()
    elif flag == "-Ss":
        if not pkg:
            say("Search for what?")
            return
        search(pkg)
    elif flag == "-Si":
        if not pkg:
            say("Info about what?")
            return
        info(pkg, installed=False)
    elif flag == "-Qi":
        if not pkg:
            say("Info about what?")
            return
        info(pkg, installed=True)
    elif flag == "-Q":
        list_installed()
    elif flag == "-Ql":
        if not pkg:
            say("List files for what package?")
            return
        list_files(pkg)
    elif flag == "-Qo":
        if not pkg:
            say("Which file?")
            return
        owns(pkg)
    elif flag == "-Sc":
        clean(full=False)
    elif flag == "-Scc":
        clean(full=True)
    else:
        say(f"I don't know what '{flag}' means. Try: dango --help")

if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\n\n✦ Interrupted.")
        sys.exit(0)
